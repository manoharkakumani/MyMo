# List, tuple, dict and string methods; indexing errors; tuple dict keys.
xs = [1, 2, 3, 2, 1]
print(xs.count(2), xs.index(2), xs.index(2, 2), xs.index(1, -1))
xs.extend(range(2))
xs.extend("ab")
print(xs)
t = (1, 2, 2, 3)
print(t.count(2), t.index(3), len(t))
d = {"a": 1, "b": 2}
print(d.get("a"), d.get("z"), d.get("z", 0), d.items())
for k, v in d.items():
    print(k, "=", v)
print(d.pop("a"), d.pop("zz", "none"), d)
print(d.setdefault("c", []), d.setdefault("b", 99), d)
d["c"].append(1)
d.update({"x": 10})
d.update([("y", 20)])
print(d, d.popitem(), d)
e = d.copy()
e["new"] = 1
d.clear()
print(d, e, len(d))
try:
    print({"k": 1}["missing"])
catch err:
    print(err)
try:
    print([1, 2][5])
catch err:
    print(err)
try:
    d.pop("nope")
catch err:
    print(err)
try:
    d[[1]] = 2
catch err:
    print(err)
print([10, 20, 30][-1], "abc"[-1], (1, 2)[0], range(0, 10, 2)[3], range(5)[-1])
class Grid:
    fn __init__(self):
        self.cells = {}
    fn __getitem__(self, key):
        return self.cells.get(key, ".")
    fn __setitem__(self, key, value):
        self.cells[key] = value
g = Grid()
g[(1, 2)] = "x"
g["a"] = "y"
print(g["a"], g["b"])
s = "  Hello World  "
print(s.strip(), "|" + s.lstrip() + "|", "|" + s.rstrip() + "|", "xxhixx".strip("x"))
print("hello".find("l"), "hello".find("l", 3), "hello".rfind("l"), "hello".index("e"), "hello".count("l"), "aaa".count(""))
print("a,b,,c".split(","), "a b  c".split(), "a,b,c".split(",", 1), " a b c ".split(Nil, 1))
print("l1\nl2\r\nl3\n".splitlines(), "k=v=w".partition("="), "k=v=w".rpartition("="), "abc".partition("x"))
print("hello world".capitalize(), "hello wORLD foo-bar".title(), "AbC".swapcase())
print("123".isdigit(), "12a".isdigit(), "abc".isalpha(), "a1".isalnum(), " \t".isspace(), "ABC".isupper(), "abc".islower(), "".isdigit())
print("[" + "ab".ljust(5) + "]", "[" + "ab".rjust(5, "*") + "]", "[" + "ab".center(6, "-") + "]", "42".zfill(5), "-42".zfill(5))
print("prefix_name".removeprefix("prefix_"), "file.txt".removesuffix(".txt"), "-".join(range(0)), "-".join(["a", "b"]), ",".join("xyz"))
try:
    "abc".index("z")
catch err:
    print(err)
grid = {}
for x in range(3):
    for y in range(3):
        grid[(x, y)] = x * 10 + y
print(grid[(2, 1)], (1, 1) in grid, (5, 5) in grid, len(grid))
nested = {((1, "a"), 2.5): "deep", (): "empty", (Nil, True): "odd"}
print(nested[((1, "a"), 2.5)], nested[()], nested[(Nil, True)])
print(grid.get((0, 2)), grid.pop((0, 0)), grid.has((0, 0)), {(1, 2): 1} == {(1, 2): 1})
i = 0
while i < 20000:
    tmp = {(i, "k"): i}
    i += 1
print(tmp[(19999, "k")], grid[(2, 2)])
try:
    grid[(1, [2])] = 3
catch e:
    print(e)
print(dict([((1, 2), "a")]), {(1, 2): 1}.setdefault((1, 2), 5))
print({"a": 1, "b": [2]} == {"b": [2], "a": 1}, {"a": 1} == {"a": 2}, {} == {}, range(0, 3) == range(3), 1 == 1.0)
print({2.5: 1}[2.5])
