# Comprehensions (list/dict, unpacking, nested for, filters), del targets,
# assert, compound assignment on subscripts, long list literals.
print([x * x for x in range(5)])
print([x for x in range(10) if x % 2 if x > 3])
print([(x, y) for x in range(3) for y in "ab" if x != 1])
print([k + "=" + str(v) for k, v in {"a": 1, "b": 2}.items()])
print({x: x * x for x in range(4)})
print({k: v for k, v in [("a", 1), ("b", 2)] if v > 1})
print({v: k for k, v in {"x": 1, "y": 2}.items()})
print([[y for y in range(x)] for x in range(4)])
fn squares(n):
    return {i: i * i for i in range(n)}
print(squares(3))
fn param_loop(x):
    return [x for x in range(x)]
print(param_loop(4))
counts = {}
for w in "the cat the dog the".split():
    counts[w] = counts.get(w, 0) + 1
print(counts)
c2 = {"a": 1}
c2["a"] += 5
c2["a"] *= 2
xs = [1, 2, 3]
xs[0] += 10
xs[-1] -= 1
xs[1] **= 3
print(c2, xs)
m = {"k": [1, 2]}
m["k"][0] += 100
print(m)
del xs[0]
del m["k"][1]
print(xs, m)
del c2["a"]
print(c2)
class P:
    fn __init__(self):
        self.a = 1
        self.b = 2
p = P()
del p.a
try:
    print(p.a)
catch e:
    print("gone:", e)
print(p.b)
assert 1 + 1 == 2
assert len(xs) == 2, "xs has two"
try:
    assert False
catch e:
    print(e)
try:
    assert 1 > 2, f"1 is not > {2}"
catch e:
    print(e)
try:
    del c2["nope"]
catch e:
    print(e)
try:
    del xs[10]
catch e:
    print(e)
try:
    assert 1 > 2, "plain"
catch e:
    print(e)
