class WideBase:
    fn __init__(self, v):
        self.wide_field_alpha = v
    fn describe(self):
        return "base " + str(self.wide_field_alpha)

class WideChild(WideBase):
    fn __init__(self, v):
        super().__init__(v * 2)
        self.wide_field_beta = v
    fn describe(self):
        return super().describe() + " child " + str(self.wide_field_beta)

w = WideChild(21)
w.wide_field_beta = w.wide_field_beta + 1
print(w.describe(), w.wide_field_alpha)
cfg = {"wide_key_one": 1, "wide_key_two": {"inner_wide": 5}}
print(cfg.wide_key_one, cfg?.wide_key_two?.inner_wide, cfg?.missing_wide_key)
fn make_adder_wide(n):
    return q => q + n

add5 = make_adder_wide(5)
print(add5(10), 7 |> add5)
fn classify_wide(t):
    case t:
        (1, _second):
            return "one-then " + str(second)
        "wide literal arm":
            return "literal"
        _:
            return "other"

print(classify_wide((1, 44)), classify_wide("wide literal arm"), classify_wide(9))
