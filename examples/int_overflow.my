# Integer overflow falls back to doubles; += on doubles, bools and big ints.
x = 1.5
x += 1
print(x)
b = True
b += 1
print(b)
big = 9223372036854775807
big += 1
print(big)
fn f():
    y = 0.5
    y += 2
    return y
print(f())
print(9223372036854775807 + 1, -9223372036854775807 - 10, 9223372036854775807 * 2, 2147483647 + 1)
s = "a"
try:
    s += 1
catch e:
    print(e)
print(int("42"), int(" -17 "), int("ff", 16), int("0xff", 16), int("0x1F", 0), int("0b101", 0), int("777", 8), int("1_000_000"), int("z", 36), int(3.9), int(-3.9), int(True), float(" 2.5 "), float("1e3"), float("inf"))
for bad in ["12a", "", " ", "0x", "1__0"]:
    try:
        int(bad)
    catch ValueError as e:
        print(e)
try:
    int("9", 8)
catch ValueError as e:
    print(e)
