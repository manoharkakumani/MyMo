# Python-style operator methods (__add__, __eq__, __lt__, __len__, __neg__, ...) and __call__.
class V:
    fn __init__(self, x):
        self.x = x
    fn __eq__(self, o):
        return self.x == o.x
    fn __lt__(self, o):
        return self.x < o.x
    fn __le__(self, o):
        return self.x <= o.x
    fn __add__(self, o):
        return V(self.x + o.x)
    fn __mul__(self, k):
        return V(self.x * k)
    fn __neg__(self):
        return V(-self.x)
    fn __len__(self):
        return self.x
    fn __contains__(self, item):
        return item == self.x
    fn __str__(self):
        return f"V({self.x})"
a = V(1)
print(a == V(1), a != V(1), a != V(2), a + V(2), a * 3, -a, len(V(4)), 4 in V(4), sorted([V(3), V(1)]), a < V(2), a <= V(1))
a += V(10)
print(a, min(V(5), V(2)), max([V(5), V(9)]))
class Adder:
    fn __init__(self, n):
        self.n = n
    fn __call__(self, x):
        return x + self.n
add5 = Adder(5)
print(add5(10), callable(add5), callable(V(1)), list(map(add5, [1, 2])))
try:
    V(1)(2)
catch TypeError as e:
    print(e)
