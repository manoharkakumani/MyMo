# Format specs in f-strings, format() and str.format(); slicing.
x = 3.14159
n = 1234567
print(f"{x:.2f}|{x:8.3f}|{x:<8.1f}|{x:^9.2f}|{x:+.1f}|{-x:.0f}|{x:e}|{x:.3g}|{0.25:%}|{0.256:.1%}")
print(f"{n:,}|{n:_}|{n:>12,}|{42:08d}|{-42:08d}|{255:x}|{255:#X}|{5:b}|{8:#o}|{65:c}|{n:,.2f}")
print(f"[{"hi":>6}][{"hi":<6}][{"hi":^6}][{"hi":*^7}][{"hello":.3}][{True}][{Nil}]")
print(f"{[1, "a"]!r} {"q"!r} {"q"!s} {1.0} {2.5!r}")
d = {"k": 5}
print(f"{d["k"]:03d} {(1 if True else 2):>3} {d}")
print(format(3.14159, ".2f"), format(42), format("s", ">3"), format(1e6, ",.0f"))
print("{} + {} = {}".format(1, 2, 3), "{1}{0}".format("a", "b"), "{name} is {age:>3}".format(name="Bo", age=7))
print("{{literal}} {0!r}".format("x"), "{:>5}|{:<5}|".format("a", "b"), "{:.1f}".format(2.25))
class Temp:
    fn __init__(self, c):
        self.c = c
    fn __str__(self):
        return f"{self.c:.1f}C"
print(f"{Temp(21.456)}", f"{Temp(3):>8}", "{}".format(Temp(1)))
for bad in [() => f"{x:q}", () => f"{"s":d}", () => "{".format(1), () => "{5}".format(1), () => "{nope}".format()]:
    try:
        bad()
    catch e:
        print(e)
xs = [0, 1, 2, 3, 4, 5]
print(xs[1:3], xs[:2], xs[4:], xs[-2:], xs[::2], xs[::-1], xs[5:1:-2], xs[10:], xs[-100:2])
s = "hello"
print(s[1:3], s[::-1], s[-3:], (1, 2, 3)[1:])
x = 3.14159
print(f"{x}")
