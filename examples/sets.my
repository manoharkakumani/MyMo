# Sets: literals, set(), comprehensions, operators and methods.
s = {3, 1, 2, 3, 1}
print(s, len(s), 2 in s, 5 in s, set(), set([1, 1, 2]), set("hello"))
a = {1, 2, 3}
b = {2, 3, 4}
print(a | b, a & b, a - b, a ^ b)
print(a.union(b, [9]), a.intersection([2, 9]), a.difference(b), a.symmetric_difference(b))
print({1, 2}.issubset(a), a.issuperset({1}), a.isdisjoint({7, 8}), a == {3, 2, 1}, a == b)
a.add(10)
a.discard(99)
a.remove(1)
a.update([20, 21], {22})
print(a, a.pop(), a)
c = a.copy()
c.clear()
print(c, a, len(c))
print({x % 3 for x in range(10)}, {(x, y) for x in range(2) for y in range(2)})
for v in {"b", "a"}:
    print(v)
print(sorted({5, 1, 3}), list({1, 2}), isinstance(a, set), type(a))
try:
    a.remove(12345)
catch e:
    print(e)
try:
    s2 = {[1]}
catch e:
    print(e)
print({"k": 1}, {(1, 2): "t"}, {})
