# in / not in, and operator precedence of not / unary minus (Python rules).
class Bag:
    fn __init__(self):
        self.items = [1, 2]
    fn __contains__(self, x):
        return x in self.items

b = Bag()
print(2 in b, 5 in b, 5 not in b, [1] in [[1], [2]], "x" in "", "" in "abc", 1 in {1: "a"}, Nil in [Nil], (1, 2) in [(1, 2)])
if 3 not in [1, 2]:
    print("not there")
print([x for x in [1, 2, 3, 4] if x in [2, 4]], not 1 in [1])

print(not 2 in [1], not 1 == 2, not True and False, not False or False, not 1 + 1 == 3, !True == False, -2 ** 2)
x = [1]
if not x:
    print("empty")
else:
    print("nonempty")
print(not Nil, not [] if False else "ok")

print(-2 ** 2, 2 ** -1, -3 * 2, -(2 ** 2), - -2, -[1, 2][0], -len("ab"))
