}

fn __svg(name, size):
    d = __ICONS.get(name, __ICONS["circle"])
    s = str(size)
    return "<svg class=\"m-icon\" width=\"" + s + "\" height=\"" + s + "\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"" + d + "\"/></svg>"

# ------------------------------------------------------- design system

__CSS = `
:root{--accent:#6366f1;--bg:#f6f6f8;--surface:#fff;--surface-2:#f1f1f4;--border:#e4e4e9;--border-strong:#d4d4dc;--text:#0f0f14;--muted:#6b6b78;--ring:color-mix(in srgb,var(--accent) 35%,transparent);--accent-fg:#fff;--accent-soft:color-mix(in srgb,var(--accent) 10%,var(--surface));
--blue:#3b82f6;--green:#16a34a;--red:#e5484d;--amber:#d97706;--violet:#8b5cf6;--pink:#ec4899;--teal:#0d9488;--gray:#71717a;--orange:#ea580c;
--r-sm:8px;--r:12px;--r-lg:16px;--sh-sm:0 1px 2px rgba(16,16,28,.05),0 1px 3px rgba(16,16,28,.05);--sh:0 1px 2px rgba(16,16,28,.04),0 4px 16px -4px rgba(16,16,28,.08);--sh-lg:0 24px 64px -16px rgba(16,16,28,.3),0 8px 24px -8px rgba(16,16,28,.15);
--font:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#09090c;--surface:#131318;--surface-2:#1a1a21;--border:#25252e;--border-strong:#33333e;--text:#ececf1;--muted:#9696a3;--sh-sm:0 1px 2px rgba(0,0,0,.4);--sh:0 1px 2px rgba(0,0,0,.4),0 8px 24px -8px rgba(0,0,0,.5);--sh-lg:0 24px 64px -16px rgba(0,0,0,.7);--accent-soft:color-mix(in srgb,var(--accent) 16%,var(--surface));color-scheme:dark}}
:root[data-theme=dark]{--bg:#09090c;--surface:#131318;--surface-2:#1a1a21;--border:#25252e;--border-strong:#33333e;--text:#ececf1;--muted:#9696a3;--sh-sm:0 1px 2px rgba(0,0,0,.4);--sh:0 1px 2px rgba(0,0,0,.4),0 8px 24px -8px rgba(0,0,0,.5);--sh-lg:0 24px 64px -16px rgba(0,0,0,.7);--accent-soft:color-mix(in srgb,var(--accent) 16%,var(--surface));color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 var(--font);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;min-height:100vh;min-height:100dvh}
::selection{background:color-mix(in srgb,var(--accent) 25%,transparent)}
#app{min-height:100vh;min-height:100dvh}
.m-page{width:100%;max-width:1120px;margin:0 auto;padding:clamp(20px,4vw,40px) clamp(16px,4vw,32px) calc(48px + env(safe-area-inset-bottom));animation:m-in .25s ease-out}
@keyframes m-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.m-col{display:flex;flex-direction:column;gap:16px;min-width:0}
.m-row{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px;min-width:0}
.m-grid{display:grid;gap:16px}
.m-center{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px;min-height:60vh}
.m-spacer{flex:1 1 auto}
.m-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--sh);padding:24px;display:flex;flex-direction:column;gap:16px;min-width:0}
.m-card-head{display:flex;flex-direction:column;gap:2px;margin-bottom:4px}
.m-card-title{font-weight:600;font-size:16px;letter-spacing:-.01em}
.m-card-sub{color:var(--muted);font-size:14px}
.m-section{display:flex;flex-direction:column;gap:16px}
.m-section-head{display:flex;flex-direction:column;gap:4px}
.m-section-head p{margin:0}
.m-h1,.m-h2,.m-h3{margin:0;font-weight:650;letter-spacing:-.022em;line-height:1.15}
.m-h1{font-size:clamp(28px,4vw,36px)}
.m-h2{font-size:22px}
.m-h3{font-size:17px;letter-spacing:-.01em}
.m-text{margin:0}
.m-muted{color:var(--muted)}
.m-bold{font-weight:600}
.m-tcenter{text-align:center}
.m-size-display{font-size:clamp(56px,12vw,96px);font-weight:700;letter-spacing:-.045em;line-height:1;font-variant-numeric:tabular-nums}.m-size-sm{font-size:13px}.m-size-lg{font-size:17px}.m-size-xl{font-size:21px;letter-spacing:-.01em}.m-size-xs{font-size:12px}
.m-code{font:13px var(--mono);background:var(--surface-2);border:1px solid var(--border);padding:1px 6px;border-radius:6px}
.m-pre{margin:0;font:13px/1.6 var(--mono);background:var(--surface-2);border:1px solid var(--border);padding:14px 16px;border-radius:var(--r);overflow:auto}
.m-link{color:var(--accent);text-decoration:none;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.m-link:hover{text-decoration:underline;text-underline-offset:3px}
.m-list{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px}
.m-kv{margin:0;display:grid;gap:0}
.m-kv>div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid var(--border)}
.m-kv>div:last-child{border-bottom:0}
.m-kv dt{color:var(--muted)}.m-kv dd{margin:0;font-weight:500;text-align:right}
.m-divider{border:0;border-top:1px solid var(--border);margin:4px 0;width:100%}
.m-divider-label{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}
.m-divider-label::before,.m-divider-label::after{content:"";flex:1;border-top:1px solid var(--border)}
.m-icon{flex:none;display:inline-block;vertical-align:middle}
.m-btn{-webkit-appearance:none;appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 14px/1 var(--font);cursor:pointer;box-shadow:var(--sh-sm);transition:background .15s,border-color .15s,box-shadow .15s,transform .08s;white-space:nowrap;user-select:none;-webkit-user-select:none;touch-action:manipulation}
.m-btn:hover{background:var(--surface-2)}
.m-btn:active{transform:scale(.97)}
.m-btn:focus-visible,.m-input:focus-visible,.m-tab:focus-visible,.m-navlink:focus-visible,.m-link:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring)}
.m-btn[disabled]{opacity:.5;cursor:not-allowed;transform:none}
.m-btn.m-primary{background:var(--accent);border-color:transparent;color:var(--accent-fg);box-shadow:0 1px 2px rgba(0,0,0,.1),inset 0 1px 0 rgba(255,255,255,.14)}
.m-btn.m-primary:hover{background:color-mix(in srgb,var(--accent) 88%,#000)}
.m-btn.m-danger{background:var(--red);border-color:transparent;color:#fff}
.m-btn.m-danger:hover{background:color-mix(in srgb,var(--red) 88%,#000)}
.m-btn.m-ghost{background:transparent;border-color:transparent;box-shadow:none}
.m-btn.m-ghost:hover{background:var(--surface-2)}
.m-btn.m-sm{height:32px;padding:0 12px;font-size:13px;border-radius:8px}
.m-btn.m-lg{height:48px;padding:0 22px;font-size:16px;border-radius:12px}
.m-btn.m-full{width:100%}
.m-btn.m-icon-only{width:40px;padding:0}.m-btn.m-sm.m-icon-only{width:32px}.m-btn.m-lg.m-icon-only{width:48px}
.m-field{display:flex;flex-direction:column;gap:6px;min-width:0}
.m-row>.m-field{flex:1 1 220px}
.m-label{font-size:13px;font-weight:500;color:var(--muted)}
.m-label-row{display:flex;justify-content:space-between}.m-label-row b{color:var(--text);font-weight:600}
.m-input{-webkit-appearance:none;appearance:none;width:100%;height:40px;padding:0 12px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:15px var(--font);transition:border-color .15s,box-shadow .15s}
.m-input::placeholder{color:color-mix(in srgb,var(--muted) 75%,transparent)}
.m-input:hover{border-color:color-mix(in srgb,var(--accent) 35%,var(--border-strong))}
.m-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--ring)}
.m-textarea{height:auto;padding:10px 12px;line-height:1.5;resize:vertical}
.m-input-wrap,.m-select-wrap{position:relative;display:flex;align-items:center}
.m-input-wrap>.m-icon{position:absolute;left:12px;color:var(--muted);pointer-events:none}
.m-input-wrap>.m-input{padding-left:36px}
.m-select{padding-right:36px;cursor:pointer}
.m-select-wrap>.m-icon{position:absolute;right:12px;color:var(--muted);pointer-events:none}
.m-check,.m-switch{display:inline-flex;align-items:center;gap:10px;cursor:pointer;user-select:none;-webkit-user-select:none;font-size:15px}
.m-check input,.m-switch input{position:absolute;opacity:0;width:1px;height:1px}
.m-box{width:20px;height:20px;border-radius:6px;border:1.5px solid var(--border-strong);background:var(--surface);display:inline-flex;align-items:center;justify-content:center;color:transparent;transition:all .15s;flex:none}
.m-check input:checked+.m-box{background:var(--accent);border-color:var(--accent);color:#fff}
.m-check input:focus-visible+.m-box,.m-switch input:focus-visible+.m-track{box-shadow:0 0 0 3px var(--ring)}
.m-track{width:40px;height:24px;border-radius:999px;background:var(--border-strong);position:relative;transition:background .2s;flex:none}
.m-thumb{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s cubic-bezier(.3,1.4,.6,1)}
.m-switch input:checked+.m-track{background:var(--accent)}
.m-switch input:checked+.m-track .m-thumb{transform:translateX(16px)}
.m-range{-webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:999px;background:linear-gradient(to right,var(--accent) var(--p,0%),var(--border-strong) var(--p,0%));outline:none;margin:10px 0}
.m-range::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:#fff;border:1px solid var(--border-strong);box-shadow:0 1px 3px rgba(0,0,0,.25);cursor:grab}
.m-range::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:#fff;border:1px solid var(--border-strong);box-shadow:0 1px 3px rgba(0,0,0,.25);cursor:grab}
.m-range:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 4px var(--ring)}
.m-tabs{align-self:flex-start;display:inline-flex;gap:2px;padding:3px;background:var(--surface-2);border:1px solid var(--border);border-radius:11px;max-width:100%;overflow-x:auto;scrollbar-width:none}
.m-tab{-webkit-appearance:none;appearance:none;border:0;background:transparent;color:var(--muted);font:500 14px var(--font);padding:7px 14px;border-radius:8px;cursor:pointer;white-space:nowrap;transition:color .15s,background .15s}
.m-tab:hover{color:var(--text)}
.m-tab.m-active{background:var(--surface);color:var(--text);box-shadow:var(--sh-sm)}
.m-badge{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:600;background:color-mix(in srgb,var(--c) 13%,transparent);color:color-mix(in srgb,var(--c) 80%,var(--text));white-space:nowrap}
.m-avatar{--size:40px;width:var(--size);height:var(--size);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex:none;object-fit:cover;font-weight:600;font-size:calc(var(--size)*.38);color:#fff;background:linear-gradient(135deg,hsl(var(--h,240) 70% 62%),hsl(calc(var(--h,240) + 40) 70% 52%))}
.m-img{max-width:100%;display:block;border-radius:var(--r);object-fit:cover}
.m-stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--sh);padding:20px;display:flex;flex-direction:column;gap:6px;min-width:0}
.m-stat-top{display:flex;justify-content:space-between;align-items:center}
.m-stat-label{color:var(--muted);font-size:13px;font-weight:500}
.m-stat-icon{width:34px;height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:var(--accent-soft);color:var(--accent)}
.m-stat-value{font-size:30px;font-weight:650;letter-spacing:-.03em;line-height:1.1;font-variant-numeric:tabular-nums}
.m-stat-foot{display:flex;gap:8px;align-items:center;font-size:13px}
.m-delta{font-weight:600;font-size:12px;padding:2px 7px;border-radius:999px}
.m-up{color:var(--green);background:color-mix(in srgb,var(--green) 12%,transparent)}
.m-down{color:var(--red);background:color-mix(in srgb,var(--red) 12%,transparent)}
.m-progress-wrap{display:flex;flex-direction:column;gap:8px;width:100%}
.m-progress-head{display:flex;justify-content:space-between;font-size:14px;font-weight:500}
.m-progress{height:8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--border);overflow:hidden}
.m-progress>div{height:100%;border-radius:999px;background:var(--c);transition:width .4s cubic-bezier(.2,.8,.2,1)}
.m-table-wrap{width:100%;overflow-x:auto;border:1px solid var(--border);border-radius:var(--r);background:var(--surface)}
.m-table{width:100%;border-collapse:collapse;font-size:14px}
.m-table th{text-align:left;font-weight:500;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;padding:10px 16px;background:var(--surface-2);border-bottom:1px solid var(--border);white-space:nowrap}
.m-table td{padding:12px 16px;border-bottom:1px solid var(--border);vertical-align:middle}
.m-table tr:last-child td{border-bottom:0}
.m-table tbody tr{transition:background .12s}
.m-table tbody tr:hover{background:color-mix(in srgb,var(--surface-2) 60%,transparent)}
.m-card>.m-table-wrap{border-radius:var(--r)}
.m-table .m-row{flex-wrap:nowrap}
.m-tabs::-webkit-scrollbar,.m-navlinks::-webkit-scrollbar,.m-sidenav::-webkit-scrollbar{display:none}
.m-alert{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:var(--r);border:1px solid color-mix(in srgb,var(--c) 30%,transparent);background:color-mix(in srgb,var(--c) 8%,var(--surface));font-size:14px}
.m-alert>.m-icon{color:var(--c);margin-top:1px}
.m-alert-title{font-weight:600;margin-bottom:2px}
.m-empty{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;padding:40px 16px}
.m-empty p{margin:0;max-width:360px}
.m-empty-icon{width:56px;height:56px;border-radius:16px;display:inline-flex;align-items:center;justify-content:center;background:var(--surface-2);border:1px solid var(--border);color:var(--muted);margin-bottom:8px}
.m-spinner{width:18px;height:18px;border-radius:50%;border:2px solid var(--border-strong);border-top-color:var(--accent);animation:m-spin .7s linear infinite;display:inline-block}
@keyframes m-spin{to{transform:rotate(360deg)}}
.m-brand{display:inline-flex;align-items:center;gap:10px;font-weight:650;font-size:16px;letter-spacing:-.01em;color:var(--text);text-decoration:none}
.m-logo{width:28px;height:28px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 60%,#000));color:#fff;font-size:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.2)}
.m-navbar{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 78%,transparent);backdrop-filter:saturate(180%) blur(14px);-webkit-backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--border);padding-top:env(safe-area-inset-top)}
.m-navbar-in{max-width:1120px;margin:0 auto;height:60px;display:flex;align-items:center;gap:20px;padding:0 clamp(16px,4vw,32px)}
.m-navlinks{display:flex;align-items:center;gap:4px;margin-left:auto;overflow-x:auto;scrollbar-width:none}
.m-navlink{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:9px;color:var(--muted);text-decoration:none;font-weight:500;font-size:14px;white-space:nowrap;transition:background .15s,color .15s}
.m-navlink:hover{color:var(--text);background:var(--surface-2)}
.m-navlink.m-active{color:var(--text);background:var(--surface-2)}
.m-with-sidebar{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh;min-height:100dvh}
.m-sidebar{position:sticky;top:0;height:100vh;height:100dvh;display:flex;flex-direction:column;gap:24px;padding:20px 14px;border-right:1px solid var(--border);background:var(--surface)}
.m-sidebar .m-brand{padding:4px 8px}
.m-sidenav{display:flex;flex-direction:column;gap:2px}
.m-sidenav .m-navlink{padding:9px 10px}
.m-sidenav .m-navlink.m-active{background:var(--accent-soft);color:var(--accent)}
@media (max-width:760px){.m-with-sidebar{grid-template-columns:minmax(0,1fr)}.m-sidenav,.m-navlinks{min-width:0}.m-sidebar{min-width:0;position:sticky;z-index:20;height:auto;flex-direction:row;align-items:center;gap:12px;padding:10px 14px;padding-top:calc(10px + env(safe-area-inset-top));border-right:0;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--surface) 85%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}.m-sidenav{flex-direction:row;overflow-x:auto;scrollbar-width:none;margin-left:auto}.m-sidenav .m-navlink{padding:8px 10px}.m-sidenav .m-navlink span{display:none}.m-sidenav .m-navlink.m-active span{display:inline}.m-sidebar .m-brand>span:last-child{display:none}.m-navbar .m-brand>span:last-child{display:none}.m-card{padding:18px}.m-kv>div{flex-direction:column;gap:2px}.m-kv dd{text-align:left}}
.m-overlay{position:fixed;inset:0;z-index:50;background:rgba(8,8,14,.45);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px;animation:m-fade .18s ease-out}
.m-dialog{width:100%;max-width:480px;max-height:calc(100dvh - 32px);overflow:auto;background:var(--surface);border:1px solid var(--border);border-radius:20px;box-shadow:var(--sh-lg);padding:22px 24px 24px;animation:m-pop .22s cubic-bezier(.2,1,.3,1)}
.m-dialog-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
@media (max-width:560px){.m-overlay{align-items:flex-end;padding:0}.m-dialog{max-width:none;border-radius:20px 20px 0 0;padding-bottom:calc(24px + env(safe-area-inset-bottom));animation:m-sheet .28s cubic-bezier(.2,1,.3,1)}}
@keyframes m-fade{from{opacity:0}}
@keyframes m-pop{from{opacity:0;transform:scale(.96) translateY(6px)}}
@keyframes m-sheet{from{transform:translateY(100%)}}
#m-toasts{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:60;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;width:max-content;max-width:calc(100vw - 32px)}
.m-toast{display:flex;align-items:center;gap:10px;background:#18181f;color:#f4f4f6;padding:11px 16px;border-radius:12px;font-size:14px;font-weight:500;box-shadow:0 12px 32px -8px rgba(0,0,0,.45);animation:m-toast-in .3s cubic-bezier(.2,1,.3,1)}
.m-toast::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--c,var(--accent));flex:none}
.m-toast.m-success{--c:var(--green)}.m-toast.m-error,.m-toast.m-danger{--c:var(--red)}.m-toast.m-warning{--c:var(--amber)}.m-toast.m-info{--c:var(--blue)}
.m-toast.m-out{opacity:0;transform:translateY(8px);transition:all .25s}
@keyframes m-toast-in{from{opacity:0;transform:translateY(12px) scale(.96)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
`

# The client: sends clicks/changes to the server and swaps in the new
# view. Kept dependency-free and small.
__JS = `
(function(){
var A=document.getElementById('app'),T=document.getElementById('m-toasts'),K=null,V=__V__,BOOT=__BOOT__,chain=Promise.resolve(),sent={};
try{var q=new URLSearchParams(location.search).get('k');if(q){localStorage.setItem('mymo-k',q);K=q}else{K=localStorage.getItem('mymo-k')}}catch(e){}
function vals(){var v={};A.querySelectorAll('[data-bind]').forEach(function(e){v[e.getAttribute('data-bind')]=e.type==='checkbox'?e.checked:(e.type==='range'||e.type==='number')?(e.value===''?null:Number(e.value)):e.value});return v}
function send(u,b){b.k=K;return fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(function(r){return r.json()})}
// Patch the live DOM to match the new HTML instead of replacing it: unchanged
// elements stay put, so focus, scroll, animations and transitions survive.
function same(a,b){return a.nodeType===b.nodeType&&a.nodeName===b.nodeName&&(a.nodeType!==1||a.getAttribute('data-key')===b.getAttribute('data-key'))}
function attrs(a,b){for(var i=a.attributes.length-1;i>=0;i--){var n=a.attributes[i].name;if(!b.hasAttribute(n))a.removeAttribute(n)}
 for(var j=0;j<b.attributes.length;j++){var x=b.attributes[j];if(a.getAttribute(x.name)!==x.value)a.setAttribute(x.name,x.value)}}
function morph(a,b){
 if(a.nodeType===3||a.nodeType===8){if(a.nodeValue!==b.nodeValue)a.nodeValue=b.nodeValue;return}
 attrs(a,b);var tag=a.nodeName,focused=a===document.activeElement;
 if(tag==='INPUT'){if(a.type==='checkbox'||a.type==='radio')a.checked=b.hasAttribute('checked');else if((!focused||a.value===sent[a.getAttribute('data-bind')])&&a.value!==(b.getAttribute('value')||''))a.value=b.getAttribute('value')||'';
  if(a.type==='range'&&!focused)a.style.setProperty('--p',b.style.getPropertyValue('--p'));return}
 if(tag==='TEXTAREA'){if((!focused||a.value===sent[a.getAttribute('data-bind')])&&a.value!==b.textContent)a.value=b.textContent;return}
 kids(a,b);
 if(tag==='SELECT'){for(var k=0;k<a.options.length;k++)if(a.options[k].hasAttribute('selected'))a.selectedIndex=k}}
function kids(a,b){var x=a.firstChild,y=b.firstChild;
 while(y){var ny=y.nextSibling;
  if(!x){a.appendChild(y)}
  else if(same(x,y)){var nx=x.nextSibling;morph(x,y);x=nx}
  else{var m=null;if(y.nodeType===1&&y.getAttribute('data-key')!=null){for(var s=x.nextSibling;s;s=s.nextSibling)if(s.nodeType===1&&s.getAttribute('data-key')===y.getAttribute('data-key')){m=s;break}}
   if(m){a.insertBefore(m,x);morph(m,y)}else{a.insertBefore(y,x)}}
  y=ny}
 while(x){var n=x.nextSibling;a.removeChild(x);x=n}}
function swap(d){
 if(d.v!=null)V=d.v;
 if(d.html!=null){var t=document.createElement('template');t.innerHTML=d.html;kids(A,t.content)}
 if(d.title)document.title=d.title;
 (d.toasts||[]).forEach(function(t){var el=document.createElement('div');el.className='m-toast m-'+t.kind;el.textContent=t.text;T.appendChild(el);setTimeout(function(){el.classList.add('m-out');setTimeout(function(){el.remove()},300)},2800)});
 if(d.go&&d.go!==location.pathname){history.pushState({},'',d.go);go(d.go)}}
function fire(id){chain=chain.then(function(){sent=vals();return send('/__ui/event',{id:id,path:location.pathname,values:sent}).then(swap)}).catch(function(e){console.error(e)})}
// Show page p. The fade-in only plays when the page actually changes
// (not when a handler goes to the page that's already showing).
var shown=location.pathname;
function go(p){chain=chain.then(function(){return send('/__ui/render',{path:p}).then(function(d){var moved=p!==shown;shown=p;swap(d);if(!moved)return;window.scrollTo(0,0);var m=A.querySelector('.m-page');if(m&&m.animate)m.animate([{opacity:0,transform:'translateY(4px)'},{opacity:1,transform:'none'}],{duration:220,easing:'ease-out'})})})}
window.__mymo={fire:fire,go:go};
document.addEventListener('click',function(ev){
 var l=ev.target.closest('a[data-link]');if(l&&!ev.metaKey&&!ev.ctrlKey){ev.preventDefault();var h=l.getAttribute('href');if(h!==location.pathname){history.pushState({},'',h);go(h)}return}
 var t=ev.target.closest('[data-on],[data-stop]');if(!t||t.hasAttribute('data-stop'))return;
 if(t.tagName==='INPUT'||t.tagName==='SELECT'||t.tagName==='LABEL')return;
 if(t.disabled)return;ev.preventDefault();fire(t.getAttribute('data-on'))});
document.addEventListener('change',function(ev){var t=ev.target;if(t.hasAttribute&&t.hasAttribute('data-on')&&(t.type==='checkbox'||t.tagName==='SELECT'||t.type==='range'))fire(t.getAttribute('data-on'))});
var timer=null;
document.addEventListener('input',function(ev){var t=ev.target;if(t.type==='range'){t.style.setProperty('--p',((t.value-t.min)*100/((t.max-t.min)||1))+'%')}
 if(t.hasAttribute&&t.hasAttribute('data-live')){clearTimeout(timer);timer=setTimeout(function(){fire(t.type==='range'?t.getAttribute('data-on'):'')},t.type==='range'?60:180)}});
document.addEventListener('keydown',function(ev){var t=ev.target;
 if(ev.key==='Enter'&&t.hasAttribute&&t.hasAttribute('data-submit')&&!ev.isComposing){ev.preventDefault();fire(t.getAttribute('data-submit'))}
 if(ev.key==='Escape'){var m=A.querySelector('[data-esc]');if(m)fire(m.getAttribute('data-esc'))}});
window.addEventListener('popstate',function(){go(location.pathname)});
// Long poll: the server answers when the view changes (another window,
// a finished background task, a timer), or after 25 s with {}.
function poll(){send('/__ui/wait',{path:location.pathname,v:V,boot:BOOT}).then(function(d){
 if(d.boot!=null&&BOOT!=null&&d.boot!==BOOT){location.reload();return}
 if(d.v!=null&&d.v>V)swap(d);poll()}).catch(function(){setTimeout(poll,1000)})}
poll();
window.addEventListener('pagehide',function(){try{navigator.sendBeacon('/__ui/bye',JSON.stringify({k:K}))}catch(e){}});
})();
`

# ------------------------------------------------------------ document

fn __icon_svg():
    t = __ui["title"]
    letter = __esc(t[0].upper() if len(t) > 0 else "M")
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"" + __ui["accent"] + "\"/><stop offset=\"1\" stop-color=\"" + __ui["accent"] + "\" stop-opacity=\".72\"/></linearGradient></defs><rect width=\"512\" height=\"512\" rx=\"112\" fill=\"url(#g)\"/><text x=\"256\" y=\"256\" dy=\".35em\" text-anchor=\"middle\" font-family=\"-apple-system,Segoe UI,Roboto,sans-serif\" font-size=\"280\" font-weight=\"700\" fill=\"#fff\">" + letter + "</text></svg>"

fn __manifest():
    start = "/"
    if __ui["key"] != Nil:
        start = "/?k=" + __ui["key"]
    return encode({
        "name": __ui["title"], "short_name": __ui["title"], "start_url": start,
        "display": "standalone", "background_color": "#09090c", "theme_color": __ui["accent"],
        "icons": [{"src": "/__ui/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable"}],
    })

# The full HTML page for `path`.
fn __document(path):
    body = __app_html(path)
    __ui["hcache"][path] = (__ui["version"], __ui["handlers"])
    theme = "" if __ui["theme"] == "auto" else " data-theme=\"" + __ui["theme"] + "\""
    head = [
        "<!doctype html><html lang=\"en\"" + theme + "><head><meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">",
        "<meta name=\"theme-color\" content=\"" + __ui["accent"] + "\">",
        "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"mobile-web-app-capable\" content=\"yes\">",
        "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">",
        "<meta name=\"apple-mobile-web-app-title\" content=\"" + __esc(__ui["title"]) + "\">",
        "<link rel=\"manifest\" href=\"/__ui/manifest.webmanifest\"><link rel=\"icon\" href=\"/__ui/icon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/__ui/icon.svg\">",
        "<title>" + __esc(__page_title(path)) + "</title>",
        "<style>" + __CSS + ":root{--accent:" + __ui["accent"] + "}" + "".join(__ui["css"]) + "</style>",
        "<link rel=\"stylesheet\" href=\"/static/app.css\">" if __exists(__root() + "static/app.css") else "",
        "</head>",
        "<body><div id=\"app\">", body, "</div><div id=\"m-toasts\" aria-live=\"polite\"></div>",
        "<script>", __JS.replace("__V__", str(__ui["version"])).replace("__BOOT__", encode(__ui["boot"])), "</script></body></html>",
    ]
    return "".join(head)

fn __take_toasts():
    t = __ui["toasts"]
    __ui["toasts"] = []
    return t

fn __reply(path):
    html = __app_html(path)
    # The next click on this page can reuse this handler table.
    __ui["hcache"][path] = (__ui["version"], __ui["handlers"])
    out = {"html": html, "toasts": __take_toasts(), "title": __page_title(path), "v": __ui["version"], "boot": __ui["boot"]}
    if __ui["go"] != Nil:
        out["go"] = __ui["go"]
        __ui["go"] = Nil
    return out

# Render the page at `path` to HTML without starting anything (for tests
# and static export).
fn render(path="/"):
    return __app_html(path)

# ---------------------------------------------------------------- server

# The project folder: where the script `mymo` ran lives.
fn __root():
    main = args[0] if len(args) > 0 else ""
    i = main.rfind("/")
    return main[:i + 1] if i >= 0 else "./"

__TYPES = {
    ".css": "text/css; charset=utf-8", ".js": "text/javascript; charset=utf-8",
    ".html": "text/html; charset=utf-8", ".txt": "text/plain; charset=utf-8",
    ".json": "application/json", ".svg": "image/svg+xml", ".png": "image/png",
    ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp",
    ".avif": "image/avif", ".ico": "image/x-icon", ".woff2": "font/woff2", ".woff": "font/woff",
    ".ttf": "font/ttf", ".mp4": "video/mp4", ".webm": "video/webm", ".mp3": "audio/mpeg",
    ".pdf": "application/pdf", ".wasm": "application/wasm",
}

# /static/<file> from the project's static/ folder.
fn __static(fd, path):
    rel = path[8:]
    parts = rel.split("/")
    if rel == "" or ".." in parts or "" in parts or rel.startswith("."):
        return respond(fd, 404, "not found", "text/plain")
    file = __root() + "static/" + rel
    if not __exists(file) or __isdir(file):
        return respond(fd, 404, "not found", "text/plain")
    dot = rel.rfind(".")
    ext = rel[dot:].lower() if dot >= 0 else ""
    return respond(fd, 200, __read_file(file), __TYPES.get(ext, "application/octet-stream"))

# ------------------------------------------------------------------ dev

# --dev: watch the project's .my and static files; on a change, check the
# changed scripts compile, then restart the app in place (the browser
# notices the new boot id and reloads).
fn __project_files(dir, out):
    for name in __listdir(dir):
        if name.startswith(".") or name == "__mycache__" or name == "node_modules":
            continue
        full = dir + name
        if __isdir(full):
            __project_files(full + "/", out)
        elif name.endswith(".my") or full.startswith(__root() + "static/"):
            out.append(full)

fn __snapshot():
    files = []
    __project_files(__root(), files)
    return {f: __mtime(f) for f in files}

fn __dev_check(close_all):
    now = monotonic()
    if now - __ui.get("dev_at", 0) < 0.4:
        return Nil
    __ui["dev_at"] = now
    snap = __snapshot()
    old = __ui.get("dev_snap")
    __ui["dev_snap"] = snap
    if old == Nil or snap == old:
        return Nil
    changed = [f for f in snap if old.get(f) != snap[f]] + [f for f in old if f not in snap]
    for f in changed:
        if f.endswith(".my") and __exists(f):
            try:
                compile(__read_file(f))
            catch:
                print("  ✗ " + f + " has an error; keeping the running version")
                toast("Error in " + f + " (see the terminal)", "error")
                __ui["version"] += 1
                return Nil
    print("  ↻ " + ", ".join([c.replace(__root(), "") for c in changed]) + " changed, reloading")
    close_all()
    setenv("MYMO_UI_RELOADED", "1")
    __exec(args)


from "server" use listen, accept_nb, read_request, respond, close as __close
from "runloop" use nonblock, ready

fn __path_only(p):
    i = p.find("?")
    return p if i < 0 else p[:i]

fn __query_key(p):
    i = p.find("k=")
    if i < 0:
        return Nil
    k = p[i + 2:]
    j = k.find("&")
    return k if j < 0 else k[:j]

__LOCKED = `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><body style="font:16px system-ui;padding:32px"><script>var k=null;try{k=localStorage.getItem('mymo-k')}catch(e){}if(k)location.replace(location.pathname+'?k='+k);else document.body.textContent='Open the link shown in the terminal to use this app.'</script>`

# Answer one HTTP request. Returns True when the connection stays open.
fn __serve_request(req):
    fd = req["client_fd"]
    method = req["method"]
    full = req["path"]
    path = __path_only(full)
    __ui["seen"] = monotonic()
    if path == "/__ui/icon.svg" or path == "/favicon.ico":
        return respond(fd, 200, __icon_svg(), "image/svg+xml")
    if path == "/__ui/manifest.webmanifest":
        return respond(fd, 200, __manifest(), "application/manifest+json")
    if path.startswith("/static/"):
        return __static(fd, path)
    if method == "POST" and path.startswith("/__ui/"):
        body = {}
        try:
            body = decode(req["body"])
        catch:
            body = {}
        if __ui["key"] != Nil and body.get("k") != __ui["key"]:
            return respond(fd, 403, "{}", "application/json")
        if path == "/__ui/bye":
            __ui["bye"] = monotonic()
            return respond(fd, 204, "", "text/plain")
        __ui["bye"] = Nil
        at = __path_only(str(body.get("path", "/")))
        if path == "/__ui/event":
            __handle(at, body.get("id"), body.get("values"), body.get("v"))
            return respond(fd, 200, encode(__reply(at)), "application/json")
        if path == "/__ui/render":
            return respond(fd, 200, encode(__reply(at)), "application/json")
        if path == "/__ui/wait":
            # Long poll: answer as soon as the view changes (see __flush).
            # A page from before a --dev restart gets the new boot id and reloads.
            if body.get("v") != __ui["version"] or len(__ui["toasts"]) > 0 or body.get("boot") != __ui["boot"]:
                return respond(fd, 200, encode(__reply(at)), "application/json")
            __ui["parked"].append({"fd": fd, "path": at, "since": monotonic()})
            return "park"
        return respond(fd, 404, "{}", "application/json")
    if __ui["key"] != Nil and __query_key(full) != __ui["key"]:
        return respond(fd, 403, __LOCKED, "text/html; charset=utf-8")
    __ui["bye"] = Nil
    status = 200 if __find_page(path) != Nil else 404
    return respond(fd, status, __document(path), "text/html; charset=utf-8")

fn __listen(host, port):
    last = Nil
    for p in range(port, port + 20):
        try:
            return (listen(host, p, 64), p)
        catch e:
            last = e
    raise last

# Answer parked long polls: with the new view once the version moved
# (each page rendered once), with {} after 25 s. Returns the fds that
# stay open.
fn __flush(force=False):
    kept = []
    if len(__ui["parked"]) == 0:
        return kept
    changed = __ui["version"] != __ui.get("flushed") or len(__ui["toasts"]) > 0
    now = monotonic()
    views = {}
    still = []
    for pk in __ui["parked"]:
        body = Nil
        if changed:
            if pk["path"] not in views:
                views[pk["path"]] = encode(__reply(pk["path"]))
            body = views[pk["path"]]
        elif force or now - pk["since"] > 25:
            body = "{}"
        if body == Nil:
            still.append(pk)
            continue
        try:
            if respond(pk["fd"], 200, body, "application/json"):
                kept.append(pk["fd"])
        catch:
            pass
    __ui["parked"] = still
    __ui["flushed"] = __ui["version"]
    return kept

fn __serve(host, port, on_ready):
    srv, p = __listen(host, port)
    nonblock(srv)
    __ui["port"] = p
    __ui["seen"] = monotonic()
    __ui["bye"] = Nil
    __ui["flushed"] = __ui["version"]
    on_ready(p)
    open = {}
    while True:
        due = __next_due()
        wait = 1000 if due < 0 or due > 1 else int(due * 1000) + 1
        if __ui["dev"] and wait > 400:
            wait = 400
        tasks = __pending_fds()
        fds = [srv] + list(open.keys()) + tasks
        got = ready(fds, wait)
        for fd in got:
            if fd == srv:
                client = accept_nb(srv)
                while client != Nil:
                    open[client] = monotonic()
                    client = accept_nb(srv)
                continue
            if fd not in open:
                continue # a task's fd: see __wake
            req = Nil
            try:
                req = read_request(fd)
            catch:
                req = Nil
            if req is False:
                continue
            open.delete(fd)
            if req == Nil:
                continue
            keep = False
            try:
                keep = __serve_request(req)
            catch e:
                print("ui: " + str(e))
                try:
                    __close(fd)
                catch:
                    pass
            if keep is True:
                open[fd] = monotonic()
        # Background work that's ready, then push any change to parked polls.
        __wake([fd for fd in got if fd in tasks])
        for fd in __flush():
            open[fd] = monotonic()
        now = monotonic()
        for fd in list(open.keys()):
            if now - open[fd] > 30:
                open.delete(fd)
                __close(fd)
        # A desktop window that closed (and didn't just reload) ends the app.
        if __ui["target"] == "desktop" and __ui["bye"] != Nil and now - __ui["bye"] > 2:
            print("window closed")
            return Nil
        if __ui["dev"]:
            fn close_all():
                for fd in list(open.keys()) + [pk["fd"] for pk in __ui["parked"]] + [srv]:
                    try:
                        __close(fd)
                    catch:
                        pass
            __dev_check(close_all)

# ------------------------------------------------------------- launchers

fn __sh_quote(s):
    return "'" + str(s).replace("'", "'\\''") + "'"

fn __has(cmd):
    return system("command -v " + cmd + " >/dev/null 2>&1") == 0

fn __open_browser(url):
    if platform == "darwin":
        system("open " + __sh_quote(url))
    elif platform == "windows":
        system("start \"\" \"" + url + "\"")
    else:
        system("xdg-open " + __sh_quote(url) + " >/dev/null 2>&1 &")

fn __profile_dir():
    if platform == "windows":
        base = getenv("LOCALAPPDATA")
        return (base if base != Nil else ".") + "\\mymo\\ui-profile"
    home = getenv("HOME")
    return (home if home != Nil else "/tmp") + "/.mymo/ui-profile"

# Open `url` as a desktop app window: a Chromium-based browser in app
# mode (no tabs or address bar). Falls back to a normal browser tab.
fn __open_window(url):
    if platform == "windows":
        system("start \"\" msedge --app=\"" + url + "\" --user-data-dir=\"" + __profile_dir() + "\" --window-size=1180,800 --no-first-run")
        return True
    flags = " --app=" + __sh_quote(url) + " --user-data-dir=" + __sh_quote(__profile_dir()) + " --window-size=1180,800 --no-first-run --no-default-browser-check"
    if platform == "darwin":
        for app in ["Google Chrome", "Microsoft Edge", "Brave Browser", "Chromium", "Arc"]:
            if system("test -d " + __sh_quote("/Applications/" + app + ".app")) == 0:
                system("open -na " + __sh_quote(app) + " --args" + flags)
                return True
    else:
        for exe in ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "microsoft-edge", "brave-browser"]:
            if __has(exe):
                system(exe + flags + " >/dev/null 2>&1 &")
                return True
    __open_browser(url)
    return False

fn __lan_ip():
    ip = ""
    try:
        if platform == "darwin":
            ip = popen("ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null").strip()
        elif platform == "linux":
            parts = popen("hostname -I 2>/dev/null").split()
            ip = parts[0] if len(parts) > 0 else ""
    catch:
        ip = ""
    return ip if ip != "" else "localhost"

fn __token():
    t = ""
    if platform != "windows":
        try:
            t = popen("head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \\n'").strip()
        catch:
            t = ""
    if len(t) < 16:
        t = str(int(monotonic() * 1000003) % 999999937)
    return t

# ------------------------------------------------------------------- run

__HELP = `usage: mymo app.my [--desktop | --phone | --term | --browser] [--port N]
  (default)   open in your browser
  --desktop   open in its own window (Chrome, Edge or Brave in app mode)
  --phone     serve on your Wi-Fi; open the printed link on your phone
  --term      run full-screen in this terminal
  --serve     just serve on localhost (open it yourself)
  --dev       reload the app when you save a file (add to any of the above)
  --html      print the page's HTML and exit
  --text      print the terminal rendering and exit`

# Start the app. `title`, `accent` (a CSS color) and `theme` ("auto",
# "light", "dark") style it; `view` registers a single-page app without
# @page. The target comes from the command line (see __HELP) unless
# `target` is given.
fn run(title=Nil, view=Nil, accent=Nil, theme=Nil, port=8765, target=Nil):
    if title != Nil:
        __ui["title"] = str(title)
    if accent != Nil:
        __ui["accent"] = accent
    if theme != Nil:
        __ui["theme"] = theme
    if view != Nil:
        page("/", view)
    if len(__ui["order"]) == 0:
        raise RuntimeError("ui.run(): no pages; decorate a view with @page(\"/\") or pass view=")
    if "/" not in __ui["pages"]:
        __ui["pages"]["/"] = __ui["pages"][__ui["order"][0]]
    flags = args[1:]
    if "--help" in flags or "-h" in flags:
        print(__HELP)
        return Nil
    for i in range(len(flags) - 1):
        if flags[i] == "--port":
            port = int(flags[i + 1])
    if target == Nil:
        target = "browser"
        for f in ["desktop", "phone", "term", "html", "text", "serve"]:
            if "--" + f in flags:
                target = f
    __ui["target"] = target
    __ui["dev"] = "--dev" in flags
    __ui["boot"] = str(monotonic())
    reloaded = getenv("MYMO_UI_RELOADED") == "1"
    if target == "html":
        print(__document("/"))
        return Nil
    if target == "text":
        print(render_text("/"))
        return Nil
    if target == "term":
        return __term_run()
    host = "127.0.0.1"
    if target == "phone":
        host = "0.0.0.0"
        __ui["key"] = __token()
    fn ready_(p):
        url = "http://127.0.0.1:" + str(p) + "/"
        if reloaded:
            return Nil # dev restart: the open window reloads itself
        if target == "phone":
            url = "http://" + __lan_ip() + ":" + str(p) + "/?k=" + __ui["key"]
            print("")
            print("  " + __ui["title"] + " is running on your network.")
            print("")
            print("  Open on your phone (same Wi-Fi):  " + url)
            print("  Then Share -> Add to Home Screen to install it as an app.")
            print("  Anyone with this link on your network can use the app.")
            print("")
        elif target == "desktop":
            print(__ui["title"] + " -> " + url + " (opening a window; close it to quit)")
            __open_window(url)
        else:
            print(__ui["title"] + " -> " + url + "  (Ctrl-C to stop" + (", reloads on save)" if __ui["dev"] else ")"))
            if target == "browser":
                __open_browser(url)
    __serve(host, port, ready_)

# ------------------------------------------------------------- terminal

from "term" use isatty, size as __tsize, raw as __traw, key as __tkey, write as __twrite
from "runloop" use ready as __tready

# Styles are ANSI SGR codes; in plain mode (render_text) they're dropped.
fn __sgr(codes, s):
    if __ui.get("plain") or s == "":
        return s
    return "\x1b[" + codes + "m" + s + "\x1b[0m"

fn __hex256(c):
    names = {"accent": __ui["accent"], "blue": "#3b82f6", "green": "#16a34a", "red": "#e5484d", "amber": "#d97706",
             "violet": "#8b5cf6", "pink": "#ec4899", "teal": "#0d9488", "gray": "#71717a", "orange": "#ea580c"}
    h = names.get(c, c)
    if typename(h) != "str" or not h.startswith("#") or len(h) != 7:
        h = __ui["accent"]
    try:
        r = int(h[1:3], 16)
        g = int(h[3:5], 16)
        b = int(h[5:7], 16)
    catch:
        return 99
    q = (v => 0 if v < 48 else 1 if v < 115 else (v - 35) // 40)
    return 16 + 36 * q(r) + 6 * q(g) + q(b)

fn __fg(color, s, bold=False):
    return __sgr(("1;" if bold else "") + "38;5;" + str(__hex256(color)), s)

fn __dim(s):
    return __sgr("2", s)

fn __bold(s):
    return __sgr("1", s)

# Terminal columns a character takes: 2 for East Asian wide characters
# and emoji, 0 for combining marks and variation selectors.
fn __cw(ch):
    c = ord(ch)
    if c < 0x300:
        return 1
    if c >= 0x300 and c < 0x370 or c == 0x200D or c >= 0xFE00 and c <= 0xFE0F:
        return 0
    if c >= 0x1100 and c <= 0x115F or c >= 0x2E80 and c <= 0xA4CF or c >= 0xAC00 and c <= 0xD7A3:
        return 2
    if c >= 0xF900 and c <= 0xFAFF or c >= 0xFF00 and c <= 0xFF60 or c >= 0xFFE0 and c <= 0xFFE6:
        return 2
    if c >= 0x1F300 and c <= 0x1FAFF or c >= 0x20000 and c <= 0x3FFFD:
        return 2
    return 1

# Visible width: terminal columns outside escape sequences (and not the
# focus marker \x01).
fn __vlen(s):
    n = 0
    esc = False
    for ch in s:
        if esc:
            if ch == "m":
                esc = False
        elif ch == "\x1b":
            esc = True
        elif ch != "\x01":
            n += __cw(ch)
    return n

fn __padr(s, w):
    n = __vlen(s)
    return s + " " * (w - n) if n < w else s

# Cut to w visible columns, keeping escape sequences.
fn __cut(s, w):
    if __vlen(s) <= w:
        return s
    out = []
    n = 0
    esc = False
    for ch in s:
        if esc:
            out.append(ch)
            if ch == "m":
                esc = False
        elif ch == "\x1b":
            esc = True
            out.append(ch)
        elif ch == "\x01":
            out.append(ch)
        elif n + __cw(ch) <= w - 1:
            out.append(ch)
            n += __cw(ch)
        elif n < w:
            out.append("…")
            n = w
    s = "".join(out)
    return s if __ui.get("plain") else s + "\x1b[0m"

fn __wrap(text, w):
    if w < 1:
        w = 1
    lines = []
    for para in str(text).split("\n"):
        cur = ""
        for word in para.split(" "):
            while len(word) > w:
                if cur != "":
                    lines.append(cur)
                    cur = ""
                lines.append(word[:w])
                word = word[w:]
            if cur == "":
                cur = word
            elif len(cur) + 1 + len(word) <= w:
                cur += " " + word
            else:
                lines.append(cur)
                cur = word
        lines.append(cur)
    return lines

fn __width(block):
    w = 0
    for l in block:
        n = __vlen(l)
        if n > w:
            w = n
    return w

# Side by side, each block padded to its width.
fn __hjoin(blocks, widths, gap):
    h = 0
    for b in blocks:
        if len(b) > h:
            h = len(b)
    out = []
    for i in range(h):
        parts = []
        for j in range(len(blocks)):
            b = blocks[j]
            parts.append(__padr(b[i] if i < len(b) else "", widths[j]))
        out.append((" " * gap).join(parts).rstrip() if __ui.get("plain") else (" " * gap).join(parts))
    return out

__GLYPHS = {
    "plus": "+", "minus": "−", "x": "✕", "check": "✓", "chevron-right": "›", "chevron-left": "‹",
    "chevron-down": "⌄", "chevron-up": "⌃", "arrow-right": "→", "arrow-left": "←", "search": "⌕",
    "home": "⌂", "user": "☺", "users": "☺", "settings": "≡", "trash": "✗", "edit": "✎", "star": "★",
    "heart": "♥", "bell": "♪", "mail": "✉", "calendar": "▦", "clock": "◷", "chart": "▥",
    "trend-up": "↗", "trend-down": "↘", "menu": "≡", "info": "ⓘ", "alert": "⚠", "check-circle": "✔",
    "sun": "☀", "moon": "☾", "folder": "▤", "file": "▢", "download": "↓", "upload": "↑", "logout": "⇥",
    "lock": "▣", "zap": "ϟ", "globe": "◍", "list": "≣", "grid": "⊞", "refresh": "↻", "inbox": "▭",
    "dollar": "$", "cart": "⊻", "send": "➤", "play": "▶", "pause": "‖", "eye": "◉", "sparkles": "✦",
    "filter": "⏷", "copy": "⧉", "external": "↗", "message": "✉", "book": "▯", "layers": "≋", "tag": "⌗",
    "map-pin": "⌖", "shield": "⛨", "terminal": "›", "code": "‹›", "image": "▣", "card": "▭", "box": "▢",
    "cloud": "☁", "cloud-sun": "☁", "cloud-rain": "☂", "cloud-snow": "❄", "cloud-lightning": "ϟ",
    "fog": "≡", "wind": "≈", "droplet": "∘", "thermometer": "°",
}

fn __glyph(name):
    return __GLYPHS.get(name, "•")

# Blocky components get a blank line around them in a column.
__BLOCKY = ["card", "section", "grid", "table", "alert", "stat", "empty", "row", "tabs", "progress", "kv", "navbar"]

fn __T_kids(kids, w, ctx, gap=Nil):
    out = []
    prev = Nil
    for k in kids:
        if k.t == "modal":
            __T_modal(k, w, ctx)
            continue
        b = __trender(k, w, ctx)
        if len(b) == 0:
            continue
        if prev != Nil and (gap != Nil and gap >= 5 or k.t in __BLOCKY or prev in __BLOCKY):
            out.append("")
        out += b
        prev = k.t
    return out

fn __trender(n, w, ctx):
    return __T[n.t](n, w, ctx)

# Register a focusable element; returns whether it has the focus.
fn __tfocus(ctx, item):
    i = len(ctx["focus"])
    ctx["focus"].append(item)
    return i == __ui["tfocus"]

fn __mark(focused, s):
    return "\x01" + s if focused and not __ui.get("plain") else s

fn __T_col(n, w, ctx):
    return __T_kids(n.kids, w, ctx, n.p.get("gap"))

fn __T_center(n, w, ctx):
    out = []
    for l in __T_kids(n.kids, w, ctx):
        pad = (w - __vlen(l)) // 2
        out.append(" " * (pad if pad > 0 else 0) + l)
    return out

fn __T_row(n, w, ctx):
    kids = [k for k in n.kids if k.t != "modal"]
    for k in n.kids:
        if k.t == "modal":
            __T_modal(k, w, ctx)
    if len(kids) == 0:
        return []
    gap = 2
    real = [k for k in kids if k.t != "spacer"]
    spacers = len(kids) - len(real)
    # Cards, stats and the like fill whatever width they get: share it.
    blocky = len([k for k in real if k.t in ["card", "stat", "grid", "table", "section", "progress", "input", "textarea"]]) > 0
    # Natural widths: render once with the full width. Focus registration
    # must happen exactly once per element, so render into a scratch ctx
    # and replay the registrations with the final layout.
    avail = w - gap * (len(real) - 1)
    if not blocky:
        mark = len(ctx["focus"])
        blocks = [__trender(k, avail, ctx) for k in real]
        widths = [__width(b) for b in blocks]
        total = sum(widths) + gap * (len(real) - 1)
        if total <= w:
            if spacers > 0 or n.p.get("justify") == "between":
                # Push what follows the first spacer to the right edge.
                extra = w - total
                first = 0
                for k in kids:
                    if k.t == "spacer":
                        break
                    first += 1
                if spacers == 0:
                    first = 1
                left = blocks[:first]
                right = blocks[first:]
                lw = widths[:first]
                rw = widths[first:]
                lb = __hjoin(left, lw, gap) if len(left) > 0 else []
                rb = __hjoin(right, rw, gap) if len(right) > 0 else []
                lwid = sum(lw) + gap * (len(lw) - 1 if len(lw) > 0 else 0)
                return __hjoin([lb, rb], [lwid + extra, sum(rw) + gap * (len(rw) - 1 if len(rw) > 0 else 0)], gap if len(lb) > 0 and len(rb) > 0 else 0)
            return __hjoin(blocks, widths, gap)
        ctx["focus"] = ctx["focus"][:mark]
    share = avail // len(real)
    if share >= 16:
        blocks = [__trender(k, share, ctx) for k in real]
        return __hjoin(blocks, [share] * len(real), gap)
    return __T_kids(real, w, ctx)

fn __T_grid(n, w, ctx):
    count = len(n.kids)
    if count == 0:
        return []
    cols = n.p["cols"]
    if cols <= 0:
        minw = n.p["min"] // 8 if typename(n.p["min"]) == "int" else 28
        cols = w // (minw + 2)
    cols = 1 if cols < 1 else count if cols > count else cols
    share = (w - 2 * (cols - 1)) // cols
    out = []
    for i in range(0, count, cols):
        blocks = [__trender(k, share, ctx) for k in n.kids[i:i + cols]]
        if len(out) > 0:
            out.append("")
        out += __hjoin(blocks, [share] * len(blocks), 2)
    return out

fn __box(lines, w, title=Nil, color=Nil):
    inner = w - 4
    edge = (s => __fg(color, s)) if color != Nil else __dim
    top = "╭" + "─" * (w - 2) + "╮"
    if title != Nil:
        t = " " + __cut(str(title), w - 6) + " "
        top = edge("╭─") + __bold(t) + edge("─" * (w - 3 - __vlen(t)) + "╮")
    else:
        top = edge(top)
    out = [top]
    for l in lines:
        out.append(edge("│") + " " + __padr(__cut(l, inner), inner) + " " + edge("│"))
    out.append(edge("╰" + "─" * (w - 2) + "╯"))
    return out

fn __T_card(n, w, ctx):
    w = 12 if w < 12 else w
    body = []
    if n.p["subtitle"] != Nil:
        body += [__dim(l) for l in __wrap(n.p["subtitle"], w - 4)]
        body.append("")
    body += __T_kids(n.kids, w - 4, ctx)
    return __box(body, w, n.p["title"])

fn __T_section(n, w, ctx):
    out = [__bold(n.p["title"])]
    if n.p["subtitle"] != Nil:
        out += [__dim(l) for l in __wrap(n.p["subtitle"], w)]
    out.append("")
    return out + __T_kids(n.kids, w, ctx)

fn __T_spacer(n, w, ctx):
    return []

fn __T_divider(n, w, ctx):
    if n.p["label"] != Nil:
        l = " " + str(n.p["label"]) + " "
        side = (w - len(l)) // 2
        return [__dim("─" * side + l + "─" * (w - side - len(l)))]
    return [__dim("─" * w)]

fn __T_text(n, w, ctx):
    p = n.p
    lines = __wrap(p["text"], w)
    out = []
    for l in lines:
        if p.get("color") != Nil:
            l = __fg(p["color"], l, p.get("bold") or False)
        elif p.get("bold") or p.get("size") == "xl" or p.get("size") == "lg":
            l = __bold(l)
        elif p.get("muted"):
            l = __dim(l)
        if p.get("center"):
            l = " " * ((w - __vlen(l)) // 2) + l
        out.append(l)
    return out

fn __T_h(n, w, ctx):
    lv = n.p["level"]
    lines = __wrap(n.p["text"], w)
    if lv == 1:
        return [__fg("accent", l, True) for l in lines]
    return [__bold(l) for l in lines]

fn __T_code(n, w, ctx):
    if n.p["block"]:
        return [__dim("  " + l) for l in n.p["text"].split("\n")]
    return [__fg("teal", n.p["text"])]

fn __T_link(n, w, ctx):
    f = __tfocus(ctx, {"kind": "link", "to": n.p["to"]})
    s = (__glyph(n.p["icon"]) + " " if n.p["icon"] != Nil else "") + n.p["text"]
    return [__mark(f, __sgr("7", s) if f else __sgr("4;38;5;" + str(__hex256("accent")), s))]

fn __T_bullets(n, w, ctx):
    out = []
    for k in n.kids:
        b = __trender(k, w - 2, ctx)
        for i in range(len(b)):
            out.append((__fg("accent", "•") + " " if i == 0 else "  ") + b[i])
    return out

fn __tcell(v, ctx):
    if isinstance(v, El):
        b = __trender(v, 200, ctx)
        return b[-1] if len(b) > 0 else ""
    if v == Nil:
        return __dim("—")
    return str(v)

fn __T_kv(n, w, ctx):
    d = n.p["data"]
    kw = 0
    for k in d:
        if len(__label(k)) > kw:
            kw = len(__label(k))
    return [__dim(__label(k).ljust(kw)) + "  " + __tcell(d[k], ctx) for k in d]

fn __T_html(n, w, ctx):
    return [__dim("[html]")]

fn __T_el(n, w, ctx):
    return __T_kids(n.kids, w, ctx)

fn __T_badge(n, w, ctx):
    return [__sgr("1;38;5;" + str(__hex256(n.p["color"])), "‹" + n.p["text"] + "›")]

fn __T_avatar(n, w, ctx):
    return [__sgr("1;38;5;" + str(16 + 36 * 2 + 6 * (__hue(n.p["name"]) % 4 + 1) + 5), "(" + __initials(n.p["name"]) + ")")]

fn __T_image(n, w, ctx):
    return [__dim("[image" + (": " + str(n.p["alt"]) if n.p["alt"] != "" else "") + "]")]

fn __T_icon(n, w, ctx):
    g = __glyph(n.p["name"])
    return [__fg(n.p["color"], g) if n.p["color"] != Nil else g]

fn __T_stat(n, w, ctx):
    p = n.p
    body = [__dim(p["label"]) + ((" " + __fg("accent", __glyph(p["icon"]))) if p["icon"] != Nil else ""), __bold(p["value"])]
    foot = ""
    if p["delta"] != Nil:
        d = str(p["delta"])
        down = d.startswith("-")
        foot = __fg("red" if down else "green", ("▼ " if down else "▲ ") + d.lstrip("+-"))
    if p["hint"] != Nil:
        foot += (" " if foot != "" else "") + __dim(p["hint"])
    if foot != "":
        body.append(foot)
    return __box(body, w if w < 40 else 40)

fn __T_progress(n, w, ctx):
    pct = __pct(n.p["value"], n.p["max"])
    label = str(round(pct)) + "%"
    out = []
    if n.p["label"] != Nil:
        out.append(__padr(str(n.p["label"]), w - len(label)) + __dim(label))
    bw = w if n.p["label"] != Nil else w - len(label) - 1
    filled = int(bw * pct / 100)
    bar = __fg(n.p["color"], "█" * filled) + __dim("░" * (bw - filled))
    out.append(bar if n.p["label"] != Nil else bar + " " + __dim(label))
    return out

fn __T_table(n, w, ctx):
    rows = n.p["rows"]
    cols = __columns(rows, n.p["columns"])
    cells = []
    for r in rows:
        if typename(r) == "dict":
            cells.append([__tcell(r.get(c), ctx) for c in cols])
        else:
            cells.append([__tcell(v, ctx) for v in r])
    ncol = len(cols) if cols != Nil else (len(cells[0]) if len(cells) > 0 else 0)
    if ncol == 0:
        return []
    widths = [len(__label(c)) for c in cols] if cols != Nil else [0] * ncol
    for r in cells:
        for i in range(ncol):
            if i < len(r) and __vlen(r[i]) > widths[i]:
                widths[i] = __vlen(r[i])
    # Shrink the widest columns until the table fits.
    while sum(widths) + 2 * (ncol - 1) > w:
        big = 0
        for i in range(ncol):
            if widths[i] > widths[big]:
                big = i
        if widths[big] <= 4:
            break
        widths[big] -= 1
    out = []
    if cols != Nil:
        out.append("  ".join([__dim(__padr(__label(cols[i]).upper(), widths[i])[:widths[i]]) for i in range(ncol)]))
        out.append(__dim("─" * (sum(widths) + 2 * (ncol - 1))))
    for r in cells:
        out.append("  ".join([__padr(__cut(r[i] if i < len(r) else "", widths[i]), widths[i]) for i in range(ncol)]))
    return out

fn __T_alert(n, w, ctx):
    kind = n.p["kind"]
    color = "green" if kind == "success" else "amber" if kind == "warning" else "red" if kind == "error" or kind == "danger" else "blue"
    bar = __fg(color, "▌")
    out = []
    if n.p["title"] != Nil:
        out.append(bar + " " + __fg(color, __glyph(__kind_icon(kind)), True) + " " + __bold(n.p["title"]))
    lines = __wrap(n.p["text"], w - 2)
    for i in range(len(lines)):
        prefix = __fg(color, __glyph(__kind_icon(kind))) + " " if n.p["title"] == Nil and i == 0 else ""
        out.append(bar + " " + prefix + lines[i])
    return out

fn __T_empty(n, w, ctx):
    out = [__dim(__glyph(n.p["icon"])), __bold(n.p["title"])]
    if n.p["text"] != Nil:
        out += [__dim(l) for l in __wrap(n.p["text"], w)]
    out += __T_kids(n.kids, w, ctx)
    return [" " * ((w - __vlen(l)) // 2) + l for l in out]

fn __T_spinner(n, w, ctx):
    return [__fg("accent", "⠿") + " " + __dim(n.p["text"] if n.p["text"] != Nil else "loading")]

fn __T_button(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "button", "on": p["on"], "disabled": p["disabled"]})
    label = ((__glyph(p["icon"]) + " ") if p["icon"] != Nil else "") + p["text"]
    label = label.strip()
    if f:
        s = __sgr("1;7", " " + label + " ")
    elif p["disabled"]:
        s = __dim("[ " + label + " ]")
    elif p["variant"] == "primary":
        s = __fg("accent", "[ " + label + " ]", True)
    elif p["variant"] == "danger":
        s = __fg("red", "[ " + label + " ]", True)
    elif p["variant"] == "ghost":
        s = " " + label + " "
    else:
        s = "[ " + label + " ]"
    return [__mark(f, s)]

fn __T_field(label, value, placeholder, w, f, multiline):
    out = []
    if label != Nil:
        out.append(__dim(label))
    fw = w if w < 48 else 48
    shown = value if value != "" else placeholder
    lines = __wrap(shown, fw - 2) if multiline else [shown[-(fw - 2):] if len(shown) > fw - 2 else shown]
    for i in range(len(lines)):
        l = lines[i]
        text = l if value != "" else __dim(l)
        if f and i == len(lines) - 1:
            text = (l if value != "" else "") + __sgr("7", " ")
        out.append(__mark(f and i == 0, "  " + text))
    out.append(__fg("accent", "─" * fw) if f else __dim("─" * fw))
    return out

fn __T_input(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "input", "bind": p["bind"], "submit": p["on_submit"], "multi": False})
    v = __val(p["bind"])
    if p["type"] == "password":
        v = "•" * len(v)
    return __T_field(p["label"], v, p["placeholder"], w, f, False)

fn __T_textarea(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "input", "bind": p["bind"], "submit": Nil, "multi": True})
    return __T_field(p["label"], __val(p["bind"]), p["placeholder"], w, f, True)

fn __T_checkbox(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "check", "bind": p["bind"], "on": p["on"], "checked": p["checked"]})
    on = __checked(p)
    box = __fg("accent", "☑") if on else "☐"
    label = __sgr("7", p["text"]) if f else p["text"]
    return [__mark(f, box + " " + label)]

fn __T_switch(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "check", "bind": p["bind"], "on": p["on"], "checked": p["checked"]})
    on = __checked(p)
    sw = __fg("accent", "━●", True) if on else __dim("○━")
    label = __sgr("7", p["text"]) if f else p["text"]
    return [__mark(f, sw + " " + label + "  " + (__fg("accent", "on") if on else __dim("off")))]

fn __T_select(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "select", "bind": p["bind"], "options": p["options"], "on": p["on"]})
    cur = __val(p["bind"])
    shown = cur
    for o in p["options"]:
        v, l = __option(o)
        if v == cur:
            shown = l
    s = "‹ " + shown + " ›"
    out = []
    if p["label"] != Nil:
        out.append(__dim(p["label"]))
    out.append(__mark(f, __sgr("7", s) if f else __fg("accent", s)))
    return out

fn __T_slider(n, w, ctx):
    p = n.p
    f = __tfocus(ctx, {"kind": "slider", "bind": p["bind"], "min": p["min"], "max": p["max"], "step": p["step"], "on": p["on"]})
    v = p["bind"].value if p["bind"] != Nil else p["min"]
    bw = (w if w < 40 else 40) - 1
    pos = int(bw * __pct(v - p["min"], p["max"] - p["min"]) / 100)
    bar = __fg("accent", "━" * pos) + (__sgr("7", "●") if f else __fg("accent", "●", True)) + __dim("┄" * (bw - pos))
    out = []
    if p["label"] != Nil:
        out.append(__padr(__dim(p["label"]), bw - len(str(v)) + 1) + __bold(str(v)))
    out.append(__mark(f, bar))
    return out

fn __T_tabs(n, w, ctx):
    b = n.p["bind"]
    f = __tfocus(ctx, {"kind": "tabs", "bind": b, "options": n.p["options"], "on": n.p["on"]})
    parts = []
    for o in n.p["options"]:
        v, l = __option(o)
        active = b != Nil and str(b.value) == v
        if active:
            parts.append(__sgr("1;7", " " + l + " ") if f else __sgr("1;4;38;5;" + str(__hex256("accent")), " " + l + " "))
        else:
            parts.append(__dim(" " + l + " "))
    return [__mark(f, "".join(parts))]

fn __tbrand(brand):
    return __fg("accent", "◆ " + (str(brand) if not isinstance(brand, El) else "App"), True)

fn __T_navbar(n, w, ctx):
    items = []
    for k in n.kids:
        b = __trender(k, w, ctx)
        if len(b) > 0:
            items.append(b[0])
    line = __tbrand(n.p["brand"]) + "   " + "  ".join(items)
    return [line, __dim("─" * w)]

fn __T_nav(n, w, ctx):
    active = __ui["path"] == n.p["to"]
    f = __tfocus(ctx, {"kind": "link", "to": n.p["to"]})
    s = ((__glyph(n.p["icon"]) + " ") if n.p["icon"] != Nil else "") + n.p["text"]
    if f:
        s = __sgr("7", " " + s + " ")
    elif active:
        s = __fg("accent", " " + s + " ", True)
    else:
        s = " " + s + " "
    return [__mark(f, s)]

fn __T_sidebar(n, w, ctx):
    out = [__tbrand(n.p["brand"]), ""]
    for k in n.kids:
        out += __trender(k, w, ctx)
    return out

fn __T_shell(n, w, ctx):
    chrome = n.p["chrome"]
    if chrome != Nil and chrome.t == "sidebar" and w >= 72:
        sw = 22
        side = __T_sidebar(chrome, sw - 2, ctx)
        body = __T_kids(n.kids, w - sw - 1, ctx)
        rows = len(side) if len(side) > len(body) else len(body)
        out = []
        for i in range(rows):
            l = side[i] if i < len(side) else ""
            r = body[i] if i < len(body) else ""
            out.append(__padr(l, sw - 1) + __dim("│") + " " + r)
        return out
    out = []
    if chrome != Nil:
        if chrome.t == "sidebar":
            out = __T_navbar(El("navbar", chrome.kids, {"brand": chrome.p["brand"]}), w, ctx)
        else:
            out = __T_navbar(chrome, w, ctx)
        out.append("")
    return out + __T_kids(n.kids, w, ctx)

# An open modal takes over the screen (see __term_frame).
fn __T_modal(n, w, ctx):
    b = n.p["bind"]
    if b != Nil and b.value and ctx.get("modal") == Nil:
        ctx["modal"] = n
    return []

__T = {
    "col": __T_col, "row": __T_row, "grid": __T_grid, "center": __T_center,
    "card": __T_card, "section": __T_section, "spacer": __T_spacer,
    "divider": __T_divider, "text": __T_text, "h": __T_h, "code": __T_code,
    "link": __T_link, "bullets": __T_bullets, "kv": __T_kv, "html": __T_html,
    "el": __T_el, "badge": __T_badge, "avatar": __T_avatar, "image": __T_image,
    "icon": __T_icon, "stat": __T_stat, "progress": __T_progress,
    "table": __T_table, "alert": __T_alert, "empty": __T_empty,
    "spinner": __T_spinner, "button": __T_button, "input": __T_input,
    "textarea": __T_textarea, "checkbox": __T_checkbox, "switch": __T_switch,
    "select": __T_select, "slider": __T_slider, "tabs": __T_tabs,
    "navbar": __T_navbar, "sidebar": __T_sidebar, "nav": __T_nav,
    "shell": __T_shell, "modal": __T_modal,
}

# Lay out the view at `path` for a w-column terminal: (lines, ctx).
fn __term_frame(path, w):
    node = __view(path)
    ctx = {"focus": [], "modal": Nil}
    lines = __trender(node, w, ctx)
    m = ctx["modal"]
    if m != Nil:
        # Only the dialog is interactive while it's open.
        ctx = {"focus": [], "modal": m}
        bw = w if w < 64 else 64
        body = __T_kids(m.kids, bw - 4, ctx)
        body += ["", __dim("esc to close")]
        box = __box(body, bw, m.p["title"], "accent")
        left = " " * ((w - bw) // 2)
        lines = ["", ""] + [left + l for l in box]
    return (lines, ctx)

# The view at `path` as plain text (no colors), e.g. for tests.
fn render_text(path="/", width=80):
    __ui["plain"] = True
    __ui["tfocus"] = -1
    lines, ctx = __term_frame(path, width)
    __ui["plain"] = False
    return "\n".join([l.rstrip() for l in lines])

fn __term_act(item, k, path):
    kind = item["kind"]
    if kind == "button":
        if (k == "enter" or k == " ") and item["on"] != Nil and not item["disabled"]:
            __run_task(item["on"])
    elif kind == "link":
        if k == "enter" or k == " ":
            return item["to"]
    elif kind == "check":
        if k == "enter" or k == " ":
            if item["bind"] != Nil:
                item["bind"].toggle()
            if item["on"] != Nil:
                __run_task(item["on"])
    elif kind == "select":
        opts = [__option(o)[0] for o in item["options"]]
        if len(opts) > 0 and (k == "left" or k == "right" or k == "enter" or k == " "):
            b = item["bind"]
            cur = __val(b)
            i = opts.index(cur) if cur in opts else -1
            i = (i - 1 if k == "left" else i + 1) % len(opts)
            if b != Nil:
                b.set(opts[i])
            if item["on"] != Nil:
                __run_task(item["on"])
    elif kind == "slider":
        b = item["bind"]
        steps = {"left": -1, "right": 1, "pagedown": -10, "pageup": 10, "home": -1000000, "end": 1000000}
        if b != Nil and k in steps:
            v = b.value + steps[k] * item["step"]
            v = item["min"] if v < item["min"] else item["max"] if v > item["max"] else v
            b.set(v)
            if item["on"] != Nil:
                __run_task(item["on"])
    elif kind == "tabs":
        b = item["bind"]
        opts = [__option(o)[0] for o in item["options"]]
        if b != Nil and len(opts) > 0 and (k == "left" or k == "right"):
            i = opts.index(str(b.value)) if str(b.value) in opts else 0
            i = (i - 1 if k == "left" else i + 1) % len(opts)
            __run_task((__tab, b, opts[i], item["on"]))
    elif kind == "input":
        b = item["bind"]
        if b == Nil:
            return Nil
        v = __val(b)
        if k == "backspace":
            b.set(v[:-1])
        elif k == "enter":
            if item["multi"]:
                b.set(v + "\n")
            elif item["submit"] != Nil:
                __run_task(item["submit"])
        elif len(k) == 1:
            b.set(v + k)
    return Nil

fn __term_run():
    if not isatty():
        print(render_text("/"))
        return Nil
    path = "/"
    scroll = 0
    toast_until = 0
    toast_text = ""
    __traw(True)
    __twrite("\x1b[?1049h\x1b[?25l")
    try:
        while True:
            cols, rows = __tsize()
            w = cols - 4 if cols > 104 else cols - 2
            w = 100 if w > 100 else w
            lines, ctx = __term_frame(path, w)
            nf = len(ctx["focus"])
            if __ui["tfocus"] >= nf:
                __ui["tfocus"] = nf - 1 if nf > 0 else 0
                lines, ctx = __term_frame(path, w)
            # Keep the focused line on screen.
            fline = 0
            for i in range(len(lines)):
                if "\x01" in lines[i]:
                    fline = i
                    lines[i] = lines[i].replace("\x01", "")
            height = rows - 2
            if fline < scroll:
                scroll = fline
            elif fline >= scroll + height:
                scroll = fline - height + 1
            if scroll > len(lines) - height:
                scroll = len(lines) - height if len(lines) > height else 0
            for t in __take_toasts():
                toast_text = (__fg("red", "✕ ") if t["kind"] == "error" else __fg("green", "✓ ")) + t["text"]
                toast_until = monotonic() + 3
            status = toast_text if monotonic() < toast_until else __dim("↑↓ move · enter select · ←→ change · esc quit")
            margin = " " * ((cols - w) // 2)
            screen = ["\x1b[H"]
            view = lines[scroll:scroll + height]
            screen.append("\r\n")
            for l in view:
                screen.append("\x1b[2K" + margin + __cut(l, w) + "\r\n")
            for i in range(height - len(view)):
                screen.append("\x1b[2K\r\n")
            screen.append("\x1b[2K" + margin + __cut(status, w))
            __twrite("".join(screen))
            # Wait for a key, but wake up for background tasks and timers.
            due = __next_due()
            wait = -1 if due < 0 else int(due * 1000) + 1
            if len(__ui["waiting"]) > 0:
                wait = 30 if wait < 0 or wait > 30 else wait
            if monotonic() < toast_until:
                wait = 500 if wait < 0 or wait > 500 else wait
            k = __tkey(wait)
            tasks = __pending_fds()
            __wake(__tready(tasks, 0) if len(tasks) > 0 else [])
            if k == Nil:
                continue
            if k == "ctrl-c":
                return Nil
            if k == "esc":
                if ctx["modal"] != Nil:
                    ctx["modal"].p["bind"].set(False)
                    __ui["tfocus"] = 0
                    continue
                return Nil
            item = ctx["focus"][__ui["tfocus"]] if nf > 0 else Nil
            typing = item != Nil and item["kind"] == "input"
            if k == "q" and not typing:
                return Nil
            if k == "down" or k == "tab":
                __ui["tfocus"] = (__ui["tfocus"] + 1) % nf if nf > 0 else 0
                continue
            if k == "up" or k == "shift-tab":
                __ui["tfocus"] = (__ui["tfocus"] - 1) % nf if nf > 0 else 0
                continue
            if item == Nil:
                continue
            go_to = Nil
            try:
                go_to = __term_act(item, k, path)
            catch e:
                toast(str(e), "error")
            __ui["version"] += 1
            if __ui["go"] != Nil:
                go_to = __ui["go"]
                __ui["go"] = Nil
            if go_to != Nil and go_to != path:
                if go_to.startswith("http"):
                    __open_browser(go_to)
                else:
                    path = go_to
                    __ui["tfocus"] = 0
                    scroll = 0
    final:
        __twrite("\x1b[0m\x1b[?25h\x1b[?1049l")
        __traw(False)
