# ui: build an app once, run it in a browser, a desktop window, on your
# phone or in the terminal.
#
#   from "ui" use *
#
#   count = 0
#
#   page "/":
#       card "Counter":
#           text "Clicked {count} times"
#           row:
#               button "-": count -= 1
#               button "+" primary: count += 1
#
#   run "Counter"
#
#   mymo app.my              browser tab
#   mymo app.my --desktop    its own desktop window
#   mymo app.my --phone      served on your Wi-Fi for your phone
#   mymo app.my --term       full-screen terminal app
#
# A page's block describes the screen: every component created inside a
# block becomes a child of the block's component. When the user does
# something, the handler block runs and the page is drawn again, so the
# screen always shows the current data. Inputs edit a `state(v)`.
#
# Everything also works as plain calls: card(h1("Hi"), title="x"),
# button("+", on=f), page("/", view_fn).

from "json" use encode, decode
from "os" use args, platform, popen, system, getenv, setenv, exec as __exec
from "io" use read as __read_file, exists as __exists, mtime as __mtime, listdir as __listdir, isdir as __isdir
from "time" use monotonic, sleep as __time_sleep
from "_http" use hosting as __hosting, can_yield as __can_yield

__ui = {
    "pages": {}, "order": [], "title": "MyMo App", "accent": "#6366f1",
    "theme": "auto", "states": [], "handlers": [], "toasts": [],
    "timers": [], "version": 0, "path": "/", "go": Nil, "target": "browser",
    "key": Nil, "tfocus": 0, "build": [], "waiting": [], "sleepers": [],
    "hcache": {}, "parked": [], "boot": Nil, "css": [], "dev": False,
}

# ---------------------------------------------------------------- state

# A value that inputs edit: `name = state("")`, then `input name`. Read
# it with `name.value` or "{name}", change it with set/inc/dec/toggle/
# push/remove/clear. Plain variables are fine for everything else.
class State:
    fn __init__(self, value):
        self.value = value
        self.id = str(len(__ui["states"]))
        __ui["states"].append(self)

    fn get(self):
        return self.value

    fn set(self, value):
        self.value = value

    fn inc(self, n=1):
        self.value += n

    fn dec(self, n=1):
        self.value -= n

    fn toggle(self):
        self.value = not self.value

    fn push(self, item):
        self.value.append(item)

    fn remove(self, item):
        self.value.remove(item)

    fn clear(self):
        self.value = "" if typename(self.value) == "str" else []

    fn __str__(self):
        return str(self.value)

fn state(value=Nil):
    return State(value)

# ---------------------------------------------------------------- nodes

# A component. While a block runs (__collect), every new component joins
# that block's list of children; a component passed to another as an
# argument leaves it again (__detach), so nesting calls still works.
class El:
    fn __init__(self, t, kids, p):
        self.t = t
        self.kids = kids
        self.p = p
        b = __ui["build"]
        if len(b) > 0:
            b[-1].append(self)

fn __detach(node):
    b = __ui["build"]
    if len(b) == 0:
        return Nil
    top = b[-1]
    for i in range(len(top) - 1, -1, -1):
        if top[i] is node:
            top.pop(i)
            return Nil

# Components inside data (table cells, kv values, a brand) aren't
# children of the enclosing block either.
fn __detach_data(v):
    if isinstance(v, El):
        __detach(v)
    elif typename(v) == "list" or typename(v) == "tuple":
        for x in v:
            __detach_data(x)
    elif typename(v) == "dict":
        for k in v:
            __detach_data(v[k])

# Run a block and return the components it created.
fn __collect(body):
    __ui["build"].append([])
    try:
        body()
    final:
        made = __ui["build"].pop()
    return made

# Children: Nil/False are skipped (so `x if cond else Nil` works), lists
# and tuples are spliced in, anything else that isn't a component is
# shown as text.
fn __kids(items):
    out = []
    __flatten(items, out)
    return out

fn __flatten(items, out):
    for k in items:
        if k == Nil or k is False:
            continue
        name = typename(k)
        if name == "list" or name == "tuple":
            __flatten(k, out)
        elif isinstance(k, El):
            __detach(k)
            out.append(k)
        elif callable(k):
            continue
        else:
            t = El("text", [], {"text": str(k)})
            __detach(t)
            out.append(t)

# Children given as arguments plus those created by the block.
fn __node(t, kids, p, body=Nil):
    items = __kids(kids)
    if body != Nil:
        items += __collect(body)
    return El(t, items, p)

# `card "Title":` - with a block, a leading string is the title.
fn __title_first(kids, title, body):
    if body != Nil and title == Nil and len(kids) > 0 and typename(kids[0]) == "str":
        return (kids[1:], kids[0])
    return (kids, title)

# Call fn(item) for each item and collect the results.
fn each(items, fn_):
    out = []
    for item in items:
        out.append(fn_(item))
    return out

# ----------------------------------------------------------- components

# Layout
fn col(*kids, body=Nil, **p):
    return __node("col", kids, p, body)

fn row(*kids, body=Nil, **p):
    return __node("row", kids, p, body)

fn grid(*kids, cols=0, min=220, body=Nil, **p):
    p["cols"] = cols
    p["min"] = min
    return __node("grid", kids, p, body)

fn center(*kids, body=Nil, **p):
    return __node("center", kids, p, body)

fn card(*kids, title=Nil, subtitle=Nil, body=Nil, **p):
    kids, title = __title_first(kids, title, body)
    p["title"] = title
    p["subtitle"] = subtitle
    return __node("card", kids, p, body)

fn section(*kids, title=Nil, subtitle=Nil, body=Nil, **p):
    if title == Nil and len(kids) > 0 and typename(kids[0]) == "str":
        title = kids[0]
        kids = kids[1:]
    p["title"] = title if title != Nil else ""
    p["subtitle"] = subtitle
    return __node("section", kids, p, body)

fn spacer():
    return El("spacer", [], {})

fn divider(label=Nil):
    return El("divider", [], {"label": label})

# Text
fn text(*parts, muted=False, size=Nil, bold=False, color=Nil, center=False, **p):
    p["text"] = " ".join([str(x) for x in parts])
    p["muted"] = muted
    p["size"] = size
    p["bold"] = bold
    p["color"] = color
    p["center"] = center
    return El("text", [], p)

fn __heading(level, parts, p):
    p["text"] = " ".join([str(x) for x in parts])
    p["level"] = level
    return El("h", [], p)

fn h1(*parts, **p):
    return __heading(1, parts, p)

fn h2(*parts, **p):
    return __heading(2, parts, p)

fn h3(*parts, **p):
    return __heading(3, parts, p)

fn small(*parts, **p):
    return text(*parts, size="sm", muted=True, **p)

fn code(s, block=False):
    return El("code", [], {"text": str(s), "block": block})

fn link(label, to, external=False, icon=Nil):
    return El("link", [], {"text": str(label), "to": to, "external": external, "icon": icon})

fn bullets(*items, body=Nil):
    if len(items) == 1 and (typename(items[0]) == "list" or typename(items[0]) == "tuple"):
        items = items[0]
    return __node("bullets", items, {}, body)

fn kv(data):
    __detach_data(data)
    return El("kv", [], {"data": data})

fn html(raw):
    return El("html", [], {"html": raw})

fn el(tag, *kids, body=Nil, **attrs):
    return __node("el", kids, {"tag": tag, "attrs": attrs}, body)

# Display
fn badge(label, color="accent"):
    return El("badge", [], {"text": str(label), "color": color})

fn avatar(name="", src=Nil, size=40):
    return El("avatar", [], {"name": str(name), "src": src, "size": size})

fn image(src, alt="", height=Nil, round=False):
    return El("image", [], {"src": src, "alt": alt, "height": height, "round": round})

fn icon(name, size=18, color=Nil):
    return El("icon", [], {"name": name, "size": size, "color": color})

fn stat(label, value, delta=Nil, icon=Nil, hint=Nil):
    return El("stat", [], {"label": str(label), "value": str(value), "delta": delta, "icon": icon, "hint": hint})

fn progress(value, max=100, label=Nil, color="accent"):
    return El("progress", [], {"value": value, "max": max, "label": label, "color": color})

fn table(rows, columns=Nil):
    __detach_data(rows)
    return El("table", [], {"rows": rows, "columns": columns})

fn alert(message, kind="info", title=Nil, success=False, warning=False, error=False):
    kind = "success" if success else "warning" if warning else "error" if error else kind
    return El("alert", [], {"text": str(message), "kind": kind, "title": title})

fn empty(title, message=Nil, icon="inbox", action=Nil, body=Nil):
    return __node("empty", [action], {"title": title, "text": message, "icon": icon}, body)

fn spinner(label=Nil):
    return El("spinner", [], {"text": label})

# Input. A handler (`on=`, or the block) is a function, or a tuple
# (fn, arg, ...) to call with those arguments.
fn button(label="", on=Nil, primary=False, danger=False, ghost=False, icon=Nil,
          size=Nil, full=False, disabled=False, small=False, large=False, body=Nil, **p):
    p["text"] = str(label)
    p["on"] = on if on != Nil else body
    p["variant"] = "primary" if primary else "danger" if danger else "ghost" if ghost else ""
    p["icon"] = icon
    p["size"] = "sm" if small else "lg" if large else size
    p["full"] = full
    p["disabled"] = disabled
    return El("button", [], p)

fn __bound(v):
    return v if isinstance(v, State) else Nil

fn input(bind=Nil, placeholder="", label=Nil, type="text", on_submit=Nil, live=False, icon=Nil,
         password=False, body=Nil, **p):
    p["bind"] = __bound(bind)
    p["placeholder"] = placeholder
    p["label"] = label
    p["type"] = "password" if password else type
    p["on_submit"] = on_submit if on_submit != Nil else body
    p["live"] = live
    p["icon"] = icon
    return El("input", [], p)

field = input

fn textarea(bind=Nil, placeholder="", label=Nil, rows=4, live=False, **p):
    p["bind"] = __bound(bind)
    p["placeholder"] = placeholder
    p["label"] = label
    p["rows"] = rows
    p["live"] = live
    return El("textarea", [], p)

# checkbox "Done", t["done"]: t["done"] = not t["done"]   (value + handler)
# checkbox "Agree", agreed                               (a state)
fn __toggle(kind, label, value, bind, checked, on, body):
    if bind == Nil and isinstance(value, State):
        bind = value
    elif checked == Nil and value != Nil:
        checked = value
    return El(kind, [], {"text": str(label), "bind": bind, "checked": checked, "on": on if on != Nil else body})

fn checkbox(label, value=Nil, bind=Nil, checked=Nil, on=Nil, body=Nil):
    return __toggle("checkbox", label, value, bind, checked, on, body)

fn switch(label, value=Nil, bind=Nil, checked=Nil, on=Nil, body=Nil):
    return __toggle("switch", label, value, bind, checked, on, body)

fn select(options, bind=Nil, label=Nil, on=Nil, body=Nil):
    return El("select", [], {"options": options, "bind": __bound(bind), "label": label, "on": on if on != Nil else body})

fn slider(bind, min=0, max=100, step=1, label=Nil, on=Nil, body=Nil):
    return El("slider", [], {"bind": __bound(bind), "min": min, "max": max, "step": step, "label": label, "on": on if on != Nil else body})

fn tabs(options, bind, on=Nil, body=Nil):
    return El("tabs", [], {"options": options, "bind": __bound(bind), "on": on if on != Nil else body})

# Navigation and app chrome
fn navbar(brand, *items, body=Nil, **p):
    __detach_data(brand)
    p["brand"] = brand
    return __node("navbar", items, p, body)

fn sidebar(brand, *items, body=Nil, **p):
    __detach_data(brand)
    p["brand"] = brand
    return __node("sidebar", items, p, body)

fn nav(label, to, icon=Nil):
    return El("nav", [], {"text": str(label), "to": to, "icon": icon})

# shell(chrome, *content), or `shell:` with a sidebar/navbar as the
# block's first component.
fn shell(*content, chrome=Nil, body=Nil, **p):
    kids = __kids(content)
    if body != Nil:
        kids += __collect(body)
    if chrome == Nil and len(kids) > 0 and (kids[0].t == "sidebar" or kids[0].t == "navbar"):
        chrome = kids[0]
        kids = kids[1:]
    elif chrome != Nil:
        __detach(chrome)
    p["chrome"] = chrome
    return El("shell", kids, p)

# Overlays
fn modal(bind, *kids, title=Nil, body=Nil):
    kids, title = __title_first(kids, title, body)
    return __node("modal", kids, {"bind": __bound(bind), "title": title}, body)

# Extra CSS for the whole app (a project's static/app.css is included
# automatically as well):   css ".hero { padding: 64px }"
fn css(text):
    __ui["css"].append(str(text))

# toast "Saved" success    (or error / warning; the default is info)
fn toast(message, kind="info", success=False, error=False, warning=False):
    kind = "success" if success else "error" if error else "warning" if warning else kind
    __ui["toasts"].append({"text": str(message), "kind": kind})

# Go to another page (from a handler).
fn go(path):
    __ui["go"] = path

# Run fn (or the block) every `seconds` while the app is open.
fn every(seconds, fn_=Nil, body=Nil):
    __ui["timers"].append({"every": seconds, "next": monotonic() + seconds, "fn": fn_ if fn_ != Nil else body})

# ---------------------------------------------------------------- pages

# `page "/path":` + a block, @page("/path") above a view function, or
# page("/path", view). The first page registered is the home page.
fn page(path="/", view=Nil, title=Nil, body=Nil):
    if callable(path) and view == Nil:
        view = path
        path = "/"
    if view == Nil:
        view = body
    __ui["pages"][path] = {"view": view, "title": title}
    __ui["order"].append(path)
    return view

fn __find_page(path):
    if path in __ui["pages"]:
        return __ui["pages"][path]
    return Nil

# Build the page's component tree: what the view returns, or else what
# it created. Errors in a view become an error card instead of taking
# the app down.
fn __view(path):
    __ui["path"] = path
    __ui["handlers"] = []
    __ui["build"] = []
    pg = __find_page(path)
    if pg == Nil:
        return center(empty("Page not found", "Nothing lives at " + path + ".", icon="alert",
                            action=link("Go home", "/")))
    node = Nil
    made = []
    __ui["build"].append(made)
    try:
        node = pg["view"]()
    catch e:
        __ui["build"] = []
        return alert(str(e), kind="error", title="This view raised an error")
    __ui["build"] = []
    if isinstance(node, El):
        return node
    if typename(node) == "list" or typename(node) == "tuple":
        return col(*node)
    if node != Nil:
        return text(node)
    if len(made) == 1:
        return made[0]
    return col(*made)

fn __page_title(path):
    pg = __find_page(path)
    if pg != Nil and pg["title"] != Nil:
        return pg["title"] + " · " + __ui["title"]
    return __ui["title"]

# Handlers get small integer ids in render order; the same view drawn
# again hands out the same ids, which is how a click finds its handler.
fn __hid(h):
    if h == Nil:
        return Nil
    __ui["handlers"].append(h)
    return str(len(__ui["handlers"]) - 1)

fn __call(h):
    if typename(h) == "tuple":
        f = h[0]
        f(*h[1:])
    else:
        h()

# Apply values posted by the client to the states they're bound to.
fn __apply(values):
    if values == Nil:
        return Nil
    states = __ui["states"]
    for k in values:
        i = int(k)
        if i < 0 or i >= len(states):
            continue
        s = states[i]
        v = values[k]
        old = s.value
        name = typename(old)
        if name == "int" and typename(v) == "str":
            try:
                v = int(v)
            catch:
                v = old
        elif name == "double" and typename(v) != "double":
            try:
                v = float(v)
            catch:
                v = old
        elif name == "int" and typename(v) == "double" and v == int(v):
            v = int(v)
        s.value = v

# ---------------------------------------------------------------- tasks
#
# Handlers, timers and spawn blocks run as tasks: fibers the event loop
# steps. A task that calls `http` (or `sleep`) is parked until its
# answer arrives, and the app keeps serving everyone meanwhile; when a
# task changes something, the version goes up and every open window is
# pushed the new view.

# Start `h` (a handler: function or (fn, args...) tuple) as a task.
fn __run_task(h):
    __step(fiber(() => __call(h)), True, Nil)

fn __step(f, first, value):
    __hosting(True)
    signal = Nil
    try:
        signal = f.run() if first else f.resume(value)
    catch e:
        toast(str(e), kind="error")
    final:
        __hosting(False)
    if f.alive():
        if typename(signal) == "dict" and "fd" in signal:
            __ui["waiting"].append({"fd": signal["fd"], "fiber": f})
            return Nil
        at = monotonic()
        if typename(signal) == "dict" and "sleep" in signal:
            at += signal["sleep"] / 1000
        __ui["sleepers"].append({"at": at, "fiber": f})

# Resume tasks whose socket is readable (`ready` fds) or whose sleep is
# over. Returns whether any ran.
fn __wake(ready_fds):
    ran = False
    if len(__ui["waiting"]) > 0 and len(ready_fds) > 0:
        still = []
        due = []
        for w in __ui["waiting"]:
            if w["fd"] in ready_fds:
                due.append(w)
            else:
                still.append(w)
        __ui["waiting"] = still
        for w in due:
            __step(w["fiber"], False, Nil)
            ran = True
    if len(__ui["sleepers"]) > 0:
        now = monotonic()
        still = []
        due = []
        for sl in __ui["sleepers"]:
            if sl["at"] <= now:
                due.append(sl)
            else:
                still.append(sl)
        __ui["sleepers"] = still
        for sl in due:
            __step(sl["fiber"], False, Nil)
            ran = True
    if __run_timers():
        ran = True
    if ran:
        __ui["version"] += 1
    return ran

fn __run_timers():
    now = monotonic()
    ran = False
    for t in __ui["timers"]:
        if now >= t["next"]:
            t["next"] = now + t["every"]
            __run_task(t["fn"])
            ran = True
    return ran

# Seconds until a sleeper or timer is due (0 if overdue, -1 if none).
fn __next_due():
    now = monotonic()
    best = Nil
    for sl in __ui["sleepers"]:
        if best == Nil or sl["at"] - now < best:
            best = sl["at"] - now
    for t in __ui["timers"]:
        if best == Nil or t["next"] - now < best:
            best = t["next"] - now
    if best == Nil:
        return -1
    return 0 if best < 0 else best

fn __pending_fds():
    return [w["fd"] for w in __ui["waiting"]]

# Run the block (or fn) as a background task, e.g. to load data when the
# app starts:   spawn: users = get(url).json
fn spawn(fn_=Nil, body=Nil):
    __run_task(fn_ if fn_ != Nil else body)

# Pause the current handler for `seconds` without freezing the app.
fn sleep(seconds):
    if __can_yield():
        yield({"sleep": seconds * 1000})
    else:
        __time_sleep(seconds)

# Run handler `id` of the view at `path` (after applying `values`). `v`
# is the version the client's page was drawn at: when it's current, the
# handler table from that render is reused instead of drawing again.
fn __handle(path, id, values, v=Nil):
    __apply(values)
    cached = __ui["hcache"].get(path)
    if cached != Nil and v != Nil and cached[0] == v:
        handlers = cached[1]
    else:
        __app_html(path) # rebuild the table the client's page came from
        handlers = __ui["handlers"]
    if id != Nil and id != "":
        i = int(id)
        if i >= 0 and i < len(handlers):
            __run_task(handlers[i])
    __ui["version"] += 1

# ------------------------------------------------------------ html out

fn __esc(s):
    s = str(s)
    if "&" in s:
        s = s.replace("&", "&amp;")
    if "<" in s:
        s = s.replace("<", "&lt;")
    if ">" in s:
        s = s.replace(">", "&gt;")
    if "\"" in s:
        s = s.replace("\"", "&quot;")
    return s

# Spacing scale (px) for gap= and pad=.
__SP = [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64]

fn __sp(v):
    if typename(v) == "int" and v >= 0 and v < len(__SP):
        return str(__SP[v]) + "px"
    return __size(v)

fn __size(v):
    if typename(v) == "int" or typename(v) == "double":
        return str(v) + "px"
    return str(v)

# Common layout props -> inline style.
fn __style(p):
    s = []
    if "gap" in p:
        s.append("gap:" + __sp(p["gap"]))
    if "pad" in p:
        s.append("padding:" + __sp(p["pad"]))
    if "width" in p:
        s.append("width:" + __size(p["width"]))
    if "max" in p:
        s.append("max-width:" + __size(p["max"]))
    if "height" in p:
        s.append("height:" + __size(p["height"]))
    if p.get("grow"):
        s.append("flex:1 1 0;min-width:0")
    if "style" in p:
        s.append(p["style"])
    if len(s) == 0:
        return ""
    return " style=\"" + __esc(";".join(s)) + "\""

__ALIGN = {"start": "flex-start", "center": "center", "end": "flex-end", "stretch": "stretch", "baseline": "baseline"}
__JUSTIFY = {"start": "flex-start", "center": "center", "end": "flex-end", "between": "space-between", "around": "space-around", "evenly": "space-evenly"}

fn __flex(p):
    s = ""
    if "align" in p and p["align"] in __ALIGN:
        s += "align-items:" + __ALIGN[p["align"]] + ";"
    if "justify" in p and p["justify"] in __JUSTIFY:
        s += "justify-content:" + __JUSTIFY[p["justify"]] + ";"
    if p.get("wrap") is False:
        s += "flex-wrap:nowrap;"
    return s

fn __attrs(p, extra_style=""):
    st = __style(p)
    if extra_style != "":
        if st == "":
            st = " style=\"" + __esc(extra_style) + "\""
        else:
            st = st[:-1] + ";" + __esc(extra_style) + "\""
    a = st
    if "id" in p:
        a += " id=\"" + __esc(p["id"]) + "\""
    if "key" in p:
        a += " data-key=\"" + __esc(p["key"]) + "\""
    return a

fn __cls(base, p):
    if "cls" in p:
        return base + " " + __esc(p["cls"])
    return base

__COLORS = ["accent", "blue", "green", "red", "amber", "violet", "pink", "teal", "gray", "orange"]

fn __color(c):
    if c == Nil:
        return "var(--accent)"
    if c in __COLORS:
        return "var(--" + c + ")"
    return str(c)

fn __kind_color(kind):
    if kind == "success":
        return "var(--green)"
    if kind == "warning":
        return "var(--amber)"
    if kind == "error" or kind == "danger":
        return "var(--red)"
    return "var(--blue)"

fn __kind_icon(kind):
    if kind == "success":
        return "check-circle"
    if kind == "warning" or kind == "error" or kind == "danger":
        return "alert"
    return "info"

fn __h_kids(n, out):
    for k in n.kids:
        __H[k.t](k, out)

fn __h_col(n, out):
    out.append("<div class=\"" + __cls("m-col", n.p) + "\"" + __attrs(n.p, __flex(n.p)) + ">")
    __h_kids(n, out)
    out.append("</div>")

fn __h_row(n, out):
    out.append("<div class=\"" + __cls("m-row", n.p) + "\"" + __attrs(n.p, __flex(n.p)) + ">")
    __h_kids(n, out)
    out.append("</div>")

fn __h_grid(n, out):
    cols = n.p["cols"]
    if cols > 0:
        tmpl = "grid-template-columns:repeat(" + str(cols) + ",minmax(0,1fr))"
    else:
        tmpl = "grid-template-columns:repeat(auto-fill,minmax(min(" + __size(n.p["min"]) + ",100%),1fr))"
    out.append("<div class=\"" + __cls("m-grid", n.p) + "\"" + __attrs(n.p, tmpl) + ">")
    __h_kids(n, out)
    out.append("</div>")

fn __h_center(n, out):
    out.append("<div class=\"" + __cls("m-center", n.p) + "\"" + __attrs(n.p) + ">")
    __h_kids(n, out)
    out.append("</div>")

fn __h_card(n, out):
    out.append("<div class=\"" + __cls("m-card", n.p) + "\"" + __attrs(n.p) + ">")
    if n.p["title"] != Nil:
        out.append("<div class=\"m-card-head\"><div class=\"m-card-title\">" + __esc(n.p["title"]) + "</div>")
        if n.p["subtitle"] != Nil:
            out.append("<div class=\"m-card-sub\">" + __esc(n.p["subtitle"]) + "</div>")
        out.append("</div>")
    __h_kids(n, out)
    out.append("</div>")

fn __h_section(n, out):
    out.append("<section class=\"" + __cls("m-section", n.p) + "\"" + __attrs(n.p) + "><div class=\"m-section-head\"><h2 class=\"m-h2\">" + __esc(n.p["title"]) + "</h2>")
    if n.p["subtitle"] != Nil:
        out.append("<p class=\"m-muted\">" + __esc(n.p["subtitle"]) + "</p>")
    out.append("</div><div class=\"m-col\">")
    __h_kids(n, out)
    out.append("</div></section>")

fn __h_spacer(n, out):
    out.append("<div class=\"m-spacer\"></div>")

fn __h_divider(n, out):
    if n.p["label"] != Nil:
        out.append("<div class=\"m-divider-label\"><span>" + __esc(n.p["label"]) + "</span></div>")
    else:
        out.append("<hr class=\"m-divider\">")

fn __h_text(n, out):
    p = n.p
    c = "m-text"
    if p.get("muted"):
        c += " m-muted"
    if p.get("bold"):
        c += " m-bold"
    if p.get("center"):
        c += " m-tcenter"
    if p.get("size") != Nil:
        c += " m-size-" + str(p["size"])
    extra = ""
    if p.get("color") != Nil:
        extra = "color:" + __color(p["color"])
    out.append("<p class=\"" + __cls(c, p) + "\"" + __attrs(p, extra) + ">" + __esc(p["text"]) + "</p>")

fn __h_h(n, out):
    lv = str(n.p["level"])
    out.append("<h" + lv + " class=\"" + __cls("m-h" + lv, n.p) + "\"" + __attrs(n.p) + ">" + __esc(n.p["text"]) + "</h" + lv + ">")

fn __h_code(n, out):
    if n.p["block"]:
        out.append("<pre class=\"m-pre\"><code>" + __esc(n.p["text"]) + "</code></pre>")
    else:
        out.append("<code class=\"m-code\">" + __esc(n.p["text"]) + "</code>")

fn __h_link(n, out):
    ic = __svg(n.p["icon"], 16) if n.p["icon"] != Nil else ""
    if n.p["external"]:
        out.append("<a class=\"m-link\" href=\"" + __esc(n.p["to"]) + "\" target=\"_blank\" rel=\"noopener\">" + ic + __esc(n.p["text"]) + "</a>")
    else:
        out.append("<a class=\"m-link\" href=\"" + __esc(n.p["to"]) + "\" data-link>" + ic + __esc(n.p["text"]) + "</a>")

fn __h_bullets(n, out):
    out.append("<ul class=\"m-list\">")
    for k in n.kids:
        out.append("<li>")
        __H[k.t](k, out)
        out.append("</li>")
    out.append("</ul>")

fn __label(s):
    s = str(s).replace("_", " ")
    if len(s) == 0:
        return s
    return s[0].upper() + s[1:]

fn __cell(v, out):
    if isinstance(v, El):
        __H[v.t](v, out)
    elif v == Nil:
        out.append("<span class=\"m-muted\">—</span>")
    else:
        out.append(__esc(v))

fn __h_kv(n, out):
    out.append("<dl class=\"m-kv\">")
    d = n.p["data"]
    for k in d:
        out.append("<div><dt>" + __esc(__label(k)) + "</dt><dd>")
        __cell(d[k], out)
        out.append("</dd></div>")
    out.append("</dl>")

fn __h_html(n, out):
    out.append(str(n.p["html"]))

fn __h_el(n, out):
    tag = n.p["tag"]
    a = ""
    attrs = n.p["attrs"]
    for k in attrs:
        name = "class" if k == "class_" or k == "cls" else k.replace("_", "-")
        v = attrs[k]
        if v is True:
            a += " " + name
        elif v != Nil and v is not False:
            a += " " + name + "=\"" + __esc(v) + "\""
    out.append("<" + tag + a + ">")
    __h_kids(n, out)
    if tag not in ["img", "br", "hr", "input", "meta", "link"]:
        out.append("</" + tag + ">")

fn __h_badge(n, out):
    out.append("<span class=\"m-badge\" style=\"--c:" + __esc(__color(n.p["color"])) + "\">" + __esc(n.p["text"]) + "</span>")

fn __initials(name):
    parts = [w for w in name.split(" ") if len(w) > 0]
    if len(parts) == 0:
        return "?"
    if len(parts) == 1:
        return parts[0][0].upper()
    return (parts[0][0] + parts[-1][0]).upper()

fn __hue(s):
    h = 0
    for ch in str(s):
        h = (h * 31 + ord(ch)) % 360
    return h

fn __h_avatar(n, out):
    size = str(n.p["size"]) + "px"
    if n.p["src"] != Nil:
        out.append("<img class=\"m-avatar\" style=\"--size:" + size + "\" src=\"" + __esc(n.p["src"]) + "\" alt=\"" + __esc(n.p["name"]) + "\">")
    else:
        out.append("<span class=\"m-avatar\" style=\"--size:" + size + ";--h:" + str(__hue(n.p["name"])) + "\">" + __esc(__initials(n.p["name"])) + "</span>")

fn __h_image(n, out):
    st = ""
    if n.p["height"] != Nil:
        st += "height:" + __size(n.p["height"]) + ";"
    if n.p["round"]:
        st += "border-radius:999px;"
    out.append("<img class=\"m-img\" src=\"" + __esc(n.p["src"]) + "\" alt=\"" + __esc(n.p["alt"]) + "\" style=\"" + st + "\">")

fn __h_icon(n, out):
    svg = __svg(n.p["name"], n.p["size"])
    if n.p["color"] != Nil:
        svg = "<span style=\"color:" + __esc(__color(n.p["color"])) + ";display:inline-flex\">" + svg + "</span>"
    out.append(svg)

fn __h_stat(n, out):
    p = n.p
    out.append("<div class=\"m-stat\"><div class=\"m-stat-top\"><span class=\"m-stat-label\">" + __esc(p["label"]) + "</span>")
    if p["icon"] != Nil:
        out.append("<span class=\"m-stat-icon\">" + __svg(p["icon"], 18) + "</span>")
    out.append("</div><div class=\"m-stat-value\">" + __esc(p["value"]) + "</div>")
    if p["delta"] != Nil or p["hint"] != Nil:
        out.append("<div class=\"m-stat-foot\">")
        if p["delta"] != Nil:
            d = str(p["delta"])
            down = d.startswith("-")
            out.append("<span class=\"m-delta " + ("m-down" if down else "m-up") + "\">" + ("▼ " if down else "▲ ") + __esc(d.lstrip("+-")) + "</span>")
        if p["hint"] != Nil:
            out.append("<span class=\"m-muted\">" + __esc(p["hint"]) + "</span>")
        out.append("</div>")
    out.append("</div>")

fn __pct(value, mx):
    if mx == 0:
        return 0
    v = value * 100.0 / mx
    return 0 if v < 0 else 100 if v > 100 else v

fn __h_progress(n, out):
    pct = __pct(n.p["value"], n.p["max"])
    out.append("<div class=\"m-progress-wrap\">")
    if n.p["label"] != Nil:
        out.append("<div class=\"m-progress-head\"><span>" + __esc(n.p["label"]) + "</span><span class=\"m-muted\">" + str(round(pct)) + "%</span></div>")
    out.append("<div class=\"m-progress\" style=\"--c:" + __esc(__color(n.p["color"])) + "\"><div style=\"width:" + str(round(pct, 1)) + "%\"></div></div></div>")

fn __columns(rows, columns):
    if columns != Nil:
        return columns
    if len(rows) > 0 and typename(rows[0]) == "dict":
        return list(rows[0].keys())
    return Nil

fn __h_table(n, out):
    rows = n.p["rows"]
    cols = __columns(rows, n.p["columns"])
    out.append("<div class=\"m-table-wrap\"><table class=\"m-table\">")
    if cols != Nil:
        out.append("<thead><tr>")
        for c in cols:
            out.append("<th>" + __esc(__label(c)) + "</th>")
        out.append("</tr></thead>")
    out.append("<tbody>")
    for r in rows:
        out.append("<tr>")
        if typename(r) == "dict":
            for c in cols:
                out.append("<td>")
                __cell(r.get(c), out)
                out.append("</td>")
        else:
            for v in r:
                out.append("<td>")
                __cell(v, out)
                out.append("</td>")
        out.append("</tr>")
    out.append("</tbody></table></div>")

fn __h_alert(n, out):
    kind = n.p["kind"]
    out.append("<div class=\"m-alert\" style=\"--c:" + __kind_color(kind) + "\">" + __svg(__kind_icon(kind), 18) + "<div>")
    if n.p["title"] != Nil:
        out.append("<div class=\"m-alert-title\">" + __esc(n.p["title"]) + "</div>")
    out.append("<div>" + __esc(n.p["text"]) + "</div></div></div>")

fn __h_empty(n, out):
    out.append("<div class=\"m-empty\"><div class=\"m-empty-icon\">" + __svg(n.p["icon"], 28) + "</div><h3 class=\"m-h3\">" + __esc(n.p["title"]) + "</h3>")
    if n.p["text"] != Nil:
        out.append("<p class=\"m-muted\">" + __esc(n.p["text"]) + "</p>")
    __h_kids(n, out)
    out.append("</div>")

fn __h_spinner(n, out):
    out.append("<div class=\"m-row\" style=\"align-items:center;gap:10px\"><span class=\"m-spinner\"></span>")
    if n.p["text"] != Nil:
        out.append("<span class=\"m-muted\">" + __esc(n.p["text"]) + "</span>")
    out.append("</div>")

fn __h_button(n, out):
    p = n.p
    c = "m-btn"
    if p["variant"] != "":
        c += " m-" + p["variant"]
    if p["size"] != Nil:
        c += " m-" + str(p["size"])
    if p["full"]:
        c += " m-full"
    if p["text"] == "" and p["icon"] != Nil:
        c += " m-icon-only"
    a = " type=\"button\""
    id = __hid(p["on"])
    if id != Nil:
        a += " data-on=\"" + id + "\""
    if p["disabled"]:
        a += " disabled"
    label = "<span>" + __esc(p["text"]) + "</span>" if p["text"] != "" else ""
    ic = __svg(p["icon"], 16) if p["icon"] != Nil else ""
    out.append("<button class=\"" + __cls(c, p) + "\"" + __attrs(p) + a + ">" + ic + label + "</button>")

fn __bind_attr(b):
    if b == Nil:
        return ""
    return " data-bind=\"" + b.id + "\""

fn __val(b):
    if b == Nil or b.value == Nil:
        return ""
    return str(b.value)

fn __field_open(label, out):
    out.append("<label class=\"m-field\">")
    if label != Nil:
        out.append("<span class=\"m-label\">" + __esc(label) + "</span>")

fn __h_input(n, out):
    p = n.p
    __field_open(p["label"], out)
    a = __bind_attr(p["bind"]) + " type=\"" + __esc(p["type"]) + "\""
    a += " value=\"" + __esc(__val(p["bind"])) + "\""
    if p["placeholder"] != "":
        a += " placeholder=\"" + __esc(p["placeholder"]) + "\""
    sub = __hid(p["on_submit"])
    if sub != Nil:
        a += " data-submit=\"" + sub + "\""
    if p["live"]:
        a += " data-live"
    if p["icon"] != Nil:
        out.append("<span class=\"m-input-wrap\">" + __svg(p["icon"], 16) + "<input class=\"m-input\"" + a + __attrs(p) + "></span>")
    else:
        out.append("<input class=\"m-input\"" + a + __attrs(p) + ">")
    out.append("</label>")

fn __h_textarea(n, out):
    p = n.p
    __field_open(p["label"], out)
    a = __bind_attr(p["bind"]) + " rows=\"" + str(p["rows"]) + "\""
    if p["placeholder"] != "":
        a += " placeholder=\"" + __esc(p["placeholder"]) + "\""
    if p["live"]:
        a += " data-live"
    out.append("<textarea class=\"m-input m-textarea\"" + a + __attrs(p) + ">" + __esc(__val(p["bind"])) + "</textarea></label>")

fn __checked(p):
    if p["checked"] != Nil:
        return p["checked"]
    if p["bind"] != Nil:
        return p["bind"].value
    return False

# Checkboxes and switches without an `on` handler still re-render when
# toggled ("" = no handler), so views that read their state update.
fn __change_id(on):
    id = __hid(on)
    return "" if id == Nil else id

fn __h_checkbox(n, out):
    p = n.p
    a = __bind_attr(p["bind"]) + " data-on=\"" + __change_id(p["on"]) + "\""
    if __checked(p):
        a += " checked"
    out.append("<label class=\"m-check\"><input type=\"checkbox\"" + a + "><span class=\"m-box\">" + __svg("check", 14) + "</span><span>" + __esc(p["text"]) + "</span></label>")

fn __h_switch(n, out):
    p = n.p
    a = __bind_attr(p["bind"]) + " data-on=\"" + __change_id(p["on"]) + "\""
    if __checked(p):
        a += " checked"
    out.append("<label class=\"m-switch\"><input type=\"checkbox\"" + a + "><span class=\"m-track\"><span class=\"m-thumb\"></span></span><span>" + __esc(p["text"]) + "</span></label>")

fn __option(o):
    if typename(o) == "tuple" or typename(o) == "list":
        return (str(o[0]), str(o[1]))
    return (str(o), str(o))

fn __h_select(n, out):
    p = n.p
    __field_open(p["label"], out)
    cur = __val(p["bind"])
    out.append("<span class=\"m-select-wrap\"><select class=\"m-input m-select\"" + __bind_attr(p["bind"]) + " data-on=\"" + __change_id(p["on"]) + "\">")
    for o in p["options"]:
        v, l = __option(o)
        sel = " selected" if v == cur else ""
        out.append("<option value=\"" + __esc(v) + "\"" + sel + ">" + __esc(l) + "</option>")
    out.append("</select>" + __svg("chevron-down", 16) + "</span></label>")

fn __h_slider(n, out):
    p = n.p
    v = p["bind"].value if p["bind"] != Nil else p["min"]
    pct = __pct(v - p["min"], p["max"] - p["min"])
    out.append("<label class=\"m-field\">")
    if p["label"] != Nil:
        out.append("<span class=\"m-label m-label-row\"><span>" + __esc(p["label"]) + "</span><b>" + __esc(v) + "</b></span>")
    a = __bind_attr(p["bind"]) + " data-on=\"" + __change_id(p["on"]) + "\" data-live"
    a += " min=\"" + str(p["min"]) + "\" max=\"" + str(p["max"]) + "\" step=\"" + str(p["step"]) + "\" value=\"" + __esc(v) + "\""
    out.append("<input type=\"range\" class=\"m-range\"" + a + " style=\"--p:" + str(round(pct, 1)) + "%\"></label>")

fn __h_tabs(n, out):
    b = n.p["bind"]
    out.append("<div class=\"m-tabs\" role=\"tablist\">")
    for o in n.p["options"]:
        v, l = __option(o)
        active = b != Nil and str(b.value) == v
        id = __hid((__tab, b, v, n.p["on"])) if b != Nil else Nil
        on = " data-on=\"" + id + "\"" if id != Nil else ""
        out.append("<button type=\"button\" class=\"m-tab" + (" m-active" if active else "") + "\"" + on + ">" + __esc(l) + "</button>")
    out.append("</div>")

fn __tab(b, v, on):
    b.set(v)
    if on != Nil:
        __call(on)

fn __brand(brand):
    if isinstance(brand, El):
        o = []
        __H[brand.t](brand, o)
        return "".join(o)
    b = str(brand)
    return "<span class=\"m-logo\">" + __esc(b[0] if len(b) > 0 else "") + "</span><span>" + __esc(b) + "</span>"

fn __h_navbar(n, out):
    out.append("<header class=\"m-navbar\"><div class=\"m-navbar-in\"><a class=\"m-brand\" href=\"/\" data-link>" + __brand(n.p["brand"]) + "</a><nav class=\"m-navlinks\">")
    __h_kids(n, out)
    out.append("</nav></div></header>")

fn __h_sidebar(n, out):
    out.append("<aside class=\"m-sidebar\"><a class=\"m-brand\" href=\"/\" data-link>" + __brand(n.p["brand"]) + "</a><nav class=\"m-sidenav\">")
    __h_kids(n, out)
    out.append("</nav></aside>")

fn __h_nav(n, out):
    active = __ui["path"] == n.p["to"]
    ic = __svg(n.p["icon"], 18) if n.p["icon"] != Nil else ""
    out.append("<a class=\"m-navlink" + (" m-active" if active else "") + "\" href=\"" + __esc(n.p["to"]) + "\" data-link>" + ic + "<span>" + __esc(n.p["text"]) + "</span></a>")

fn __h_shell(n, out):
    chrome = n.p["chrome"]
    kind = "m-with-sidebar" if chrome != Nil and chrome.t == "sidebar" else "m-with-navbar"
    out.append("<div class=\"m-shell " + kind + "\">")
    if chrome != Nil:
        __H[chrome.t](chrome, out)
    out.append("<main class=\"m-page\"><div class=\"m-col\"" + __attrs(n.p) + ">")
    __h_kids(n, out)
    out.append("</div></main></div>")

fn __h_modal(n, out):
    b = n.p["bind"]
    if b == Nil or not b.value:
        return Nil
    close = __hid((b.set, False))
    out.append("<div class=\"m-overlay\" data-on=\"" + close + "\" data-esc=\"" + close + "\"><div class=\"m-dialog\" data-stop role=\"dialog\">")
    out.append("<div class=\"m-dialog-head\"><h3 class=\"m-h3\">" + __esc(n.p["title"] if n.p["title"] != Nil else "") + "</h3>")
    out.append("<button type=\"button\" class=\"m-btn m-ghost m-icon-only\" data-on=\"" + close + "\">" + __svg("x", 18) + "</button></div><div class=\"m-col\">")
    __h_kids(n, out)
    out.append("</div></div></div>")

__H = {
    "col": __h_col, "row": __h_row, "grid": __h_grid, "center": __h_center,
    "card": __h_card, "section": __h_section, "spacer": __h_spacer,
    "divider": __h_divider, "text": __h_text, "h": __h_h, "code": __h_code,
    "link": __h_link, "bullets": __h_bullets, "kv": __h_kv, "html": __h_html,
    "el": __h_el, "badge": __h_badge, "avatar": __h_avatar, "image": __h_image,
    "icon": __h_icon, "stat": __h_stat, "progress": __h_progress,
    "table": __h_table, "alert": __h_alert, "empty": __h_empty,
    "spinner": __h_spinner, "button": __h_button, "input": __h_input,
    "textarea": __h_textarea, "checkbox": __h_checkbox, "switch": __h_switch,
    "select": __h_select, "slider": __h_slider, "tabs": __h_tabs,
    "navbar": __h_navbar, "sidebar": __h_sidebar, "nav": __h_nav,
    "shell": __h_shell, "modal": __h_modal,
}

# The view at `path` as HTML (what goes inside <div id="app">).
fn __app_html(path):
    node = __view(path)
    out = []
    if node.t == "shell":
        __h_shell(node, out)
    else:
        out.append("<main class=\"m-page m-solo\">")
        __H[node.t](node, out)
        out.append("</main>")
    return "".join(out)

# ---------------------------------------------------------------- icons

