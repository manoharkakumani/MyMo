# mono: a tiny Hono.js-style web framework in pure MyMo, built on
# the `server` and `json` built-in modules.
#
# Drop this file next to your script and `from "mono" use ...`.
# (MyMo's pathResolver looks for module files relative to the
# running script, so colocation works without any install step.)
#
# Quick start (decorator style):
#   from "mono" use get, post, start
#
#   @get("/")
#   fn home(req):
#       return "hello"                        # string -> text/plain 200
#
#   @get("/todos/:id")
#   fn show(req):
#       return {"id": req["params"]["id"]}    # dict/list -> JSON 200
#
#   @post("/todos")
#   fn create(req):
#       return (201, req["json"])             # (status, body) tuple
#
#   start("127.0.0.1", 8080)
#
# `@get("/x")` above `fn h` is compiler sugar for `h = get("/x", h)`,
# so the plain call form `get("/x", handler)` works too.
#
# Handler return values (Hono-style):
#   - string            -> 200 text/plain
#   - dict / list / ... -> 200 JSON
#   - (status, body)    -> that status; body encoded as above
#   - Nil               -> nothing, if the handler already called
#                          text()/json(); otherwise 204 No Content
#
# - Any `:name` segment binds the matching request segment into
#   `req["params"][name]`.
# - JSON request bodies are auto-decoded into `req["json"]`
#   (Nil if the body doesn't look like JSON).
# - Multi-statement handlers should be written with `fn name(req):`
#   blocks and registered by name — multi-line arrow-functions
#   don't parse inside a function-call argument in MyMo today.
from "server" use listen, accept, respond, respond_json
from "json" use encode, decode

# Mutable state goes in a dict so handlers (closures) can mutate it
# without shadowing the outer binding.
__state = {"routes": [], "not_found": Nil}

# --- internal helpers -------------------------------------------------
__slen = s => s.__len__()

# Map of valid JSON-body first-characters. Used as a cheap pre-filter
# so we don't hand obviously-non-JSON bytes to json.decode (which
# raises a runtime error on garbage and would tear down the server).
__json_starts = {"{":1, "[":1, '"':1, "t":1, "f":1, "n":1, "-":1,
                 "0":1, "1":1, "2":1, "3":1, "4":1,
                 "5":1, "6":1, "7":1, "8":1, "9":1}

__has_key = (d, k) =>
    for kk in d:
        if kk == k:
            return True
    return False

__is_jsonish = body =>
    if body == Nil:
        return False
    if __slen(body) < 1:
        return False
    return __has_key(__json_starts, body[0])

# Split "/a/b/:c" → ["a", "b", ":c"]. Bare "/" → [].
fn __split_path(path):
    out = []
    n = __slen(path)
    if n == 0:
        return out
    cur = ""
    i = 0
    if path[0] == "/":
        i = 1
    while i < n:
        c = path[i]
        if c == "/":
            if __slen(cur) > 0:
                out.append(cur)
                cur = ""
        else:
            cur = cur + c
        i = i + 1
    if __slen(cur) > 0:
        out.append(cur)
    return out

# Match route segments against request segments. Returns a dict of
# `:name` bindings on success, Nil on mismatch.
fn __match(route_segs, req_segs):
    if route_segs.__len__() != req_segs.__len__():
        return Nil
    bindings = {}
    n = route_segs.__len__()
    i = 0
    while i < n:
        rseg = route_segs[i]
        if rseg.__len__() > 0 and rseg[0] == ":":
            # Strip the leading ":" to get the param name.
            name = ""
            j = 1
            m = rseg.__len__()
            while j < m:
                name = name + rseg[j]
                j = j + 1
            bindings[name] = req_segs[i]
        else:
            if rseg != req_segs[i]:
                return Nil
        i = i + 1
    return bindings

# --- public route registration ---------------------------------------
# Returns `handler` so the decorator form (`@get(path)` rebinds the
# fn name to the route helper's result) leaves the fn callable.
fn route(method, path, handler):
    segs = __split_path(path)
    __state["routes"].append({"method": method, "segs": segs, "handler": handler})
    return handler

get    = (path, handler) => route("GET",    path, handler)
post   = (path, handler) => route("POST",   path, handler)
put    = (path, handler) => route("PUT",    path, handler)
delete = (path, handler) => route("DELETE", path, handler)
patch  = (path, handler) => route("PATCH",  path, handler)

# Override the 404 handler. `handler` receives the request dict.
# Also usable as a bare decorator: `@not_found`.
fn not_found(handler):
    __state["not_found"] = handler
    return handler

# --- response helpers (call from inside a handler) -------------------
# Both mark the request as answered so the return-value auto-response
# in __dispatch_handler doesn't send a second reply.
fn text(req, status, body):
    req["__sent"] = True
    return respond(req["client_fd"], status, body)

fn json(req, status, value):
    req["__sent"] = True
    return respond_json(req["client_fd"], status, encode(value))

# Turn a handler's return value into a response (see header).
fn __auto_respond(req, result):
    if result == Nil:
        text(req, 204, "")
        return Nil
    status = 200
    body = result
    if type(result) == type(()):
        status = result[0]
        body = result[1]
    if type(body) == type(""):
        text(req, status, body)
    else:
        json(req, status, body)

# --- main loop --------------------------------------------------------
# Body decoding now uses try/catch instead of the __is_jsonish
# heuristic — anything json.decode chokes on becomes Nil cleanly.
fn __decode_body(body):
    if body == Nil:
        return Nil
    if body.__len__() == 0:
        return Nil
    try:
        return decode(body)
    catch:
        return Nil

# Per-handler error trap. Any runtime error raised inside the
# user-supplied handler turns into a 500 response. Without this
# every untreated KeyError / NameError / explicit raise would
# tear down the whole server.
fn __dispatch_handler(handler, req):
    try:
        result = handler(req)
        if req.get("__sent") != True:
            __auto_respond(req, result)
    catch e:
        try:
            body = encode({"error": "internal server error", "detail": e})
            respond_json(req["client_fd"], 500, body)
        catch:
            print("mono: could not deliver 500:", e)

fn __handle(req):
    req_segs = __split_path(req["path"])
    req["json"] = __decode_body(req["body"])
    routes = __state["routes"]
    n = routes.__len__()
    i = 0
    while i < n:
        r = routes[i]
        if r["method"] == req["method"]:
            bindings = __match(r["segs"], req_segs)
            if bindings != Nil:
                req["params"] = bindings
                __dispatch_handler(r["handler"], req)
                return Nil
        i = i + 1
    nf = __state["not_found"]
    if nf != Nil:
        __dispatch_handler(nf, req)
    else:
        body = encode({"error": "not found", "path": req["path"]})
        respond_json(req["client_fd"], 404, body)
    return Nil

fn start(host, port):
    srv = listen(host, port, 16)
    print("mono listening on http://" + host + ":" + str(port))
    while True:
        req = accept(srv)
        if req != Nil:
            __handle(req)
